// Cloudflare Workers settings (DECISIONS.md, D-38).
// The site is plain static files from `npm run build` (the dist folder); no server code runs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cueory",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get our 404 page.
    "not_found_handling": "404-page",
    // /privacy, not /privacy/ (matches trailingSlash: 'never' in astro.config.mjs).
    "html_handling": "drop-trailing-slash"
  },
  // A direct local Wrangler deploy can upload previously built dist/ without npm postbuild.
  // Recheck the exact files before upload. Normal local preview/dev is not a release.
  // Cloudflare Workers Builds ignores this hook, so its separate npm postbuild gate stays required.
  "build": {
    "command": "node scripts/anatomy-wrangler-upload-gate.mjs"
  },
  // Branch previews (every branch except main). Required by `wrangler preview`; it may stay empty.
  "previews": {}
}
