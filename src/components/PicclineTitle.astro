---
/**
 * piccline's game title mark: the SVG wordmark outline.
 * Plain text "piccline" for screen readers, SVGs for Daytime and Evening palettes.
 */
interface Props {
  name?: string;
}

const { name = 'piccline' } = Astro.props;
---

<span class="inline-flex items-center gap-3" data-testid="piccline-title">
  <span class="sr-only">{name}</span>
  <span class="logo flex items-center" aria-hidden="true">
    <img
      class="logo-day h-10 sm:h-12 w-auto"
      src="/brand/games/piccline-wordmark-light.svg"
      alt=""
      aria-hidden="true"
      width="248"
      height="100"
      loading="lazy"
      decoding="async"
    />
    <img
      class="logo-evening h-10 sm:h-12 w-auto"
      src="/brand/games/piccline-wordmark-dark.svg"
      alt=""
      aria-hidden="true"
      width="248"
      height="100"
      loading="lazy"
      decoding="async"
    />
  </span>
</span>
