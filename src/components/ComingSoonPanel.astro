---
/**
 * The one "coming soon" body for study screens that are not open yet (/start, /learn/study-skills/*). A centred serif
 * heading, one line of reused text and two real 44 px buttons, so the page never reads as a half-empty list of links.
 * Phone and desktop share this layout. Wording is passed in by each page; nothing new is written here.
 */
interface Props {
  message: string;
  /** The test id the page's own message has always carried. */
  messageTestId: string;
}
const { message, messageTestId } = Astro.props;
const button =
  'inline-flex min-h-(--tap-min) w-full items-center justify-center rounded-pill border border-control px-6 py-3 text-center text-base text-ink no-underline hover:bg-surface focus-visible:bg-surface sm:w-auto';
---

<div class="mx-auto flex min-h-(--coming-soon-min-height) max-w-prose flex-col items-center justify-center py-section text-center" data-pagefind-ignore data-coming-soon-panel>
  <h1 class="display break-words text-title text-ink sm:text-title-lg">coming soon</h1>
  <p class="mt-4 text-ink-soft" data-testid={messageTestId}>{message}</p>
  <ul class="mt-10 flex w-full max-w-sm flex-col items-center gap-3 sm:max-w-none sm:flex-row sm:justify-center">
    <li class="w-full sm:w-auto"><a class={button} href="/learn">back to learn</a></li>
    <li class="w-full sm:w-auto"><a class={button} href="/play">play the daily games</a></li>
  </ul>
</div>
