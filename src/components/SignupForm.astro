---
/**
 * Launch-updates signup, the home page's last silk scene (D-53): a frosted card with a serif heading (no section
 * numbers, D-60). A plain HTML form that posts straight to Kit, so it works without JavaScript and loads no third-party
 * script. Kit validates the address, sends the confirmation (double opt-in) email and handles unsubscribes. Until Kit
 * is connected, the card links to Kit's landing page (with no landing page either, it says only that sign ups open soon); the line about the emails comes with the form, so small
 * grey lines never stack (D-62). Lowercase brand voice (D-47).
 */
import { kitFormAction, kitLandingUrl, newsletter, signupState } from '../config/site';

const state = signupState(newsletter.formAction, newsletter.landingUrl);
const ready = state === 'form';
// Before the form exists, a plain link opens Kit's landing page: no Kit script, so no CSP change. Like the site's other
// outside links (D-54) it opens in a new tab, and its name says so.
const landingUrl = kitLandingUrl(newsletter.landingUrl);
---

<section id="signup" class="scene scene-low scroll-mt-section py-section" aria-labelledby="signup-heading">
  <div class="mx-auto max-w-prose px-gutter" data-reveal-section>
    <div class="veil p-6 text-center sm:p-10">
      <h2 id="signup-heading" class="display text-title wrap-break-word sm:text-title-lg">get launch updates</h2>
      {
        ready ? (
          <>
            <form
              action={kitFormAction(newsletter.formAction)}
              method="post"
              class="mt-4 flex flex-col gap-3 text-left sm:flex-row sm:items-end"
              data-testid="signup-form"
            >
              <div class="flex flex-1 flex-col gap-1">
                <label for="signup-email" class="text-sm text-ink-soft">
                  email address
                </label>
                <input
                  id="signup-email"
                  name={newsletter.emailFieldName}
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  inputmode="email"
                  aria-describedby="signup-email-help"
                  class="rounded-md border border-control bg-page px-4 py-3 text-ink"
                />
              </div>
              <button type="submit" class="rounded-pill bg-button px-6 py-3 text-on-button hover:bg-button-hover">
                sign up
              </button>
            </form>
            <p id="signup-email-help" class="mt-4 text-sm text-ink-soft">
              a few emails about new lessons and the launch. unsubscribe any time. emails are sent by {newsletter.provider};
              see our <a href="/privacy">privacy page</a>.
            </p>
          </>
        ) : state === 'landing' ? (
          <>
            <a
              href={landingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="glass-button mt-6"
              aria-label="get launch updates (opens in a new tab)"
              data-testid="signup-landing"
            >
              get launch updates
            </a>
            <p class="mt-4 text-sm text-ink-soft">
              you sign up on {newsletter.provider}'s page; see our <a href="/privacy">privacy page</a>.
            </p>
          </>
        ) : (
          <p class="mt-3 text-ink-soft" data-testid="signup-pending">
            sign ups open soon.
          </p>
        )
      }
    </div>
  </div>
</section>
