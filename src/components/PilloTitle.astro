---
interface Props {
  /** Optional class passed to the title container. */
  class?: string;
}

const { class: className } = Astro.props;

// Brand art files generated in Task 1 (D-47, D-49). Pillo is our friendly assistant (Task 113).
const art = { name: 'pillo', widths: [96, 192, 384], width: 384, height: 428 } as const;
const path = (mode: 'light' | 'dark', width: number) => `/brand/v1/${art.name}-${mode}-${width}.png`;
const srcset = (mode: 'light' | 'dark') => art.widths.map((width) => `${path(mode, width)} ${width}w`).join(', ');
---

<div class:list={['inline-flex items-center gap-3', className]}>
  <div class="relative flex h-10 w-10 shrink-0 items-center justify-center">
    <!-- Daytime: light mode Pillo with matching soft drop -->
    <img
      src={path('light', 96)}
      srcset={srcset('light')}
      sizes="40px"
      width={art.width}
      height={art.height}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      draggable="false"
      class="h-10 w-10 object-contain dark:hidden"
    />
    <!-- Evening: dark mode Pillo -->
    <img
      src={path('dark', 96)}
      srcset={srcset('dark')}
      sizes="40px"
      width={art.width}
      height={art.height}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      draggable="false"
      class="hidden h-10 w-10 object-contain dark:block"
    />
  </div>
  <slot />
</div>
