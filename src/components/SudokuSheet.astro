---
/**
 * sudoku's paper sheet (Christian, 2026-11-25), a print-only block on the game page: hidden on screen, and when the page
 * is printed only this prints, as exactly two pages. Page 1 is the guesser's copy (the logo, the level, the 9 by 9 grid with
 * its given numbers), page 2 the keeper's copy (how to play, a fold line, the solved grid). The level is the one chosen on
 * the page, so the grids are drawn into the empty slots by src/islands/SudokuPrintView.tsx, and the solution only at print time,
 * and only when printing is allowed. Text: src/config/sudoku-print.ts. Look: src/styles/print-sheet.css.
 */
import PrintSheetPage from './PrintSheetPage.astro';
import { sudokuSheet as t } from '../config/sudoku-print';
import '../styles/print-sheet.css';

// Sudoku has no artwork of its own, so the cueory logo (the founder's PNG, shown as is) heads the page.
const logo = '/brand/v1/logo-full-light-960.png';
---
<div class="sheet-print" data-print-sheet="sudoku" data-testid="print-sheet">
  <PrintSheetPage page={1} name={t.brand} wordmark={logo} wordmarkWidth={960} wordmarkHeight={303} label={t.copyGuesser} caption={t.caption} footer={t.footerOne} testid="sheet-page-1">
    <div data-sheet-slot="level" data-testid="sheet-level"></div>
    <div data-sheet-slot="board" data-testid="sheet-board"></div>
  </PrintSheetPage>

  <PrintSheetPage page={2} name={t.brand} wordmark={logo} wordmarkWidth={960} wordmarkHeight={303} label={t.copyKeeper} caption={t.keeperLine} footer={t.footerTwo} testid="sheet-page-2">
    <div data-sheet-slot="level-two" data-testid="sheet-level-two"></div>
    <h2 class="sheet-heading">{t.howHeading}</h2>
    <ol class="sheet-steps">
      {t.steps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="sheet-fold" data-testid="sheet-fold">{t.foldLabel}</p>
    <div class="sheet-answers" data-keeper="locked" data-testid="sheet-keeper">
      <p class="sheet-locked">{t.locked}</p>
      <div data-sheet-slot="answers"></div>
    </div>
  </PrintSheetPage>
</div>
