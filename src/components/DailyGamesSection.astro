---
/**
 * Daily games on Home v2 (Lane 5, D-61): "nurse's station games".
 * Six white playing-card style cards (280x392) in a carousel:
 * vialo, tachyyy, piccline, crossword, sudoku, hello cards.
 *
 * Each card has:
 * - Square game icon top-left (.gpip.tl) and upside down bottom-right (.gpip.br)
 * - Wordmark or serif title (.gname)
 * - One-line description (.gdesc)
 * - Today's status (.gstatus)
 * - Looping interactive demo on hover/focus (.gdemo), paused under reduced motion
 *
 * Prev/next navigation buttons (52px >= 44px tap target), arrow keys, swipe on touch, wrapping.
 * Brand tokens only, no arbitrary tailwind classes, no inline styles or raw hex.
 */
import { getCollection } from 'astro:content';
import { gameName, helloCardsGame, helloCardsIndexWhenApproved } from '../config/games';
import { crosswordShown, pageBuildEnv } from '../config/crossword';
import { draftsAllowed } from '../islands/anatomylab';
import { helloCardsPage } from '../islands/hello-cards';

const env = pageBuildEnv();
const tachyyyAvailable = draftsAllowed(env);
const crosswordAvailable = crosswordShown(env);
const tachyyyGame = {
  name: gameName('tachyyy'),
  href: '/play/tachyyy',
  line: 'fifteen fast clinical questions in 30 seconds. how sharp are you on shift today?',
} as const;

const helloEntries = await getCollection('hello-cards');
const helloCardsAvailable = helloCardsPage(
  helloEntries.map(({ data }) => data),
  env,
  helloCardsIndexWhenApproved
).shown;
---

<section id="daily-games" class="games-section" aria-labelledby="games-heading" data-reveal-section>
  <div class="games-container" role="region" aria-roledescription="carousel" aria-label="daily games" data-games-carousel data-carousel-state="settled">
    <div class="games-header">
      <div class="games-nav-slot games-nav-prev">
        <button type="button" class="glass gs-nav" data-games-prev aria-label="previous game" aria-controls="games-track">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>
      </div>
      <h2 id="games-heading" class="serif games-heading">nurse's station games</h2>
      <div class="games-nav-slot games-nav-next">
        <button type="button" class="glass gs-nav" data-games-next aria-label="next game" aria-controls="games-track">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
      <p class="games-subtitle" data-testid="daily-games-summary">inspired by your favorite daily games for you and your patients</p>
    </div>

    <div class="gcar" data-games-car>
      <div id="games-track" class="gtrack" data-games-track>
        <!-- Card 1: Vialo -->
        <a href="/play/vialo" class="gcard on" data-game-card="vialo" aria-label={`${gameName('vialo')}: guess the five-letter word in six tries`}>
          <img class="gpip tl" src="/brand/games/vialo-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
          <span class="gface">
            <span class="gname">
              <img src="/brand/games/vialo-wordmark-light.svg" alt={gameName('vialo')} width="168" height="60" loading="lazy" decoding="async" />
            </span>
            <span class="gdesc">guess the five-letter word in six tries.</span>
            <span class="gstatus" data-game-status="vialo">
              <span class="gstatus-sym" aria-hidden="true">○</span> not started
            </span>
            <span class="gdemo" aria-hidden="true">
              <span class="vialo-grid">
                <span class="vialo-row">
                  <span class="gc d-0">C</span>
                  <span class="gc cu d-30">A</span>
                  <span class="gc d-60">R</span>
                  <span class="gc d-90">E</span>
                  <span class="gc cu d-120">S</span>
                </span>
                <span class="vialo-row">
                  <span class="gc d-180">N</span>
                  <span class="gc d-210">U</span>
                  <span class="gc d-240">R</span>
                  <span class="gc d-270">S</span>
                  <span class="gc d-300">E</span>
                </span>
              </span>
            </span>
          </span>
          <img class="gpip br" src="/brand/games/vialo-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
        </a>

        <!-- Card 2: Tachyyy -->
        <a href="/play/tachyyy" class="gcard" data-game-card="tachyyy" aria-label={`${tachyyyGame.name}: quick questions against the clock`}>
          <img class="gpip tl" src="/brand/games/tachyyy-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
          <span class="gface">
            <span class="gname">
              <img src="/brand/games/tachyyy-wordmark-light.svg" alt={tachyyyGame.name} width="168" height="60" loading="lazy" decoding="async" />
            </span>
            <span class="gdesc">quick questions against the clock.</span>
            {tachyyyAvailable ? (
              <span class="gstatus" data-game-status="tachyyy">
                <span class="gstatus-sym" aria-hidden="true">○</span> not started
              </span>
            ) : (
              <span class="gstatus">coming soon</span>
            )}
            <span class="gdemo" aria-hidden="true">
              <span class="tq">
                <span class="tbar"><i></i></span>
                <span class="tq-prompt">A pt presents to ED...</span>
                <span class="tch">answer a</span>
                <span class="tch ok">answer b</span>
                <span class="tch">answer c</span>
              </span>
            </span>
          </span>
          <img class="gpip br" src="/brand/games/tachyyy-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
        </a>

        <!-- Card 3: Piccline -->
        <a href="/play/piccline" class="gcard" data-game-card="piccline" aria-label={`${gameName('piccline')}: trace hidden words through the letters`}>
          <img class="gpip tl" src="/brand/games/piccline-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
          <span class="gface">
            <span class="gname">
              <img src="/brand/games/piccline-wordmark-light.svg" alt={gameName('piccline')} width="168" height="60" loading="lazy" decoding="async" />
            </span>
            <span class="gdesc">trace hidden words through the letters.</span>
            <span class="gstatus" data-game-status="piccline">
              <span class="gstatus-sym" aria-hidden="true">○</span> not started
            </span>
            <span class="gdemo" aria-hidden="true">
              <span class="pgrid">
                <svg viewBox="0 0 132 98" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points="15,15 49,15 49,49 83,49 83,83"></polyline>
                </svg>
                <span>N</span><span>U</span><span>·</span><span>·</span>
                <span>·</span><span>R</span><span>S</span><span>·</span>
                <span>·</span><span>·</span><span>E</span><span>·</span>
              </span>
            </span>
          </span>
          <img class="gpip br" src="/brand/games/piccline-dark.svg" alt="" aria-hidden="true" width="52" height="52" loading="lazy" decoding="async" />
        </a>

        <!-- Card 4: Crossword -->
        <a href="/play/crossword" class="gcard" data-game-card="crossword" aria-label={`${gameName('cueword')}: a mini crossword from this week's lessons`}>
          <span class="gpip tl gpip-crossword" aria-hidden="true">
            <span class="pip-xgrid">
              <span class="pip-xcell-dark"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-dark"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-dark"></span>
            </span>
          </span>
          <span class="gface">
            <span class="gname">
              <span class="serif">{gameName('cueword')}</span>
            </span>
            <span class="gdesc">a mini crossword from this week's lessons.</span>
            {crosswordAvailable ? (
              <span class="gstatus" data-game-status="crossword">
                <span class="gstatus-sym" aria-hidden="true">○</span> not started
              </span>
            ) : (
              <span class="gstatus">coming soon</span>
            )}
            <span class="gdemo" aria-hidden="true">
              <span class="xg">
                <span><em class="d-0">C</em></span>
                <span><em class="d-18">A</em></span>
                <span><em class="d-36">R</em></span>
                <span><em class="d-54">E</em></span>
                <span><em class="d-72">A</em></span>
                <span class="b"></span>
                <span class="b"></span>
                <span><em class="d-126">A</em></span>
                <span><em class="d-144">R</em></span>
                <span class="b"></span>
                <span class="b"></span>
                <span><em class="d-198">T</em></span>
                <span><em class="d-216">E</em></span>
                <span><em class="d-234">A</em></span>
                <span><em class="d-252">T</em></span>
                <span><em class="d-270">S</em></span>
              </span>
            </span>
          </span>
          <span class="gpip br gpip-crossword" aria-hidden="true">
            <span class="pip-xgrid">
              <span class="pip-xcell-dark"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-dark"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-light"></span>
              <span class="pip-xcell-dark"></span>
            </span>
          </span>
        </a>

        <!-- Card 5: Sudoku -->
        <a href="/play/sudoku" class="gcard" data-game-card="sudoku" aria-label={`${gameName('triage')}: a calm numbers break`}>
          <span class="gpip tl gpip-sudoku" aria-hidden="true">9</span>
          <span class="gface">
            <span class="gname">
              <span class="serif">{gameName('triage')}</span>
            </span>
            <span class="gdesc">a calm numbers break.</span>
            <span class="gstatus" data-game-status="sudoku">
              <span class="gstatus-sym" aria-hidden="true">○</span> not started
            </span>
            <span class="gdemo" aria-hidden="true">
              <span class="sg">
                <span>4</span>
                <span><em class="d-25">3</em></span>
                <span>9</span>
                <span><em class="d-75">8</em></span>
                <span>7</span>
                <span><em class="d-125">1</em></span>
                <span>2</span>
                <span><em class="d-175">6</em></span>
                <span>5</span>
              </span>
            </span>
          </span>
          <span class="gpip br gpip-sudoku" aria-hidden="true">9</span>
        </a>

        <!-- Card 6: Hello cards -->
        <a href="/play/hello-cards" class="gcard" data-game-card="hello cards" aria-label={`${helloCardsGame.name}: flip a card, start a conversation`}>
          <span class="gpip tl gpip-hello" aria-hidden="true">hi</span>
          <span class="gface">
            <span class="gname">
              <span class="serif">{helloCardsGame.name}</span>
            </span>
            <span class="gdesc">flip a card,<br />start a conversation.</span>
            {helloCardsAvailable ? (
              <span class="gstatus" data-game-status="hello-cards">
                <span class="gstatus-sym" aria-hidden="true">○</span> not started
              </span>
            ) : (
              <span class="gstatus">coming soon</span>
            )}
            <span class="gdemo gdemo-perspective" aria-hidden="true">
              <span class="hflip">
                <span class="hface front">hello card<br />tap to flip</span>
                <span class="hface back">[a conversation starter]</span>
              </span>
            </span>
          </span>
          <span class="gpip br gpip-hello" aria-hidden="true">hi</span>
        </a>
      </div>
    </div>

    <p class="games-date-note" data-testid="daily-games-day" data-daily-games-date aria-live="polite" aria-atomic="true">
      the date changes at midnight on your device. some sample puzzles repeat.
    </p>
  </div>
</section>

<style>
  #daily-games {
    /* These tokens are local to the Home carousel so routes such as /account do not pay for its CSS. */
    --border-hairline: 1px;
    --border-game-cell: 1px;
    --game-section-max-width: 80rem;
    --game-section-padding: 4.5rem 2.5rem 1.5rem;
    --game-section-padding-phone: 3rem 1rem 1.25rem;
    --game-container-gap: 1.125rem;
    --game-header-gap: 1rem;
    --game-nav-size: 3.25rem;
    --game-nav-border: rgb(249 245 239 / 0.35);
    --game-nav-bg: rgb(249 245 239 / 0.08);
    --game-nav-bg-hover: rgb(249 245 239 / 0.18);
    --game-nav-outline-width: 0.1875rem;
    --game-nav-outline-offset: 0.1875rem;
    --game-heading-size-min: 2rem;
    --game-heading-size-max: 5.75rem;
    --game-subtitle-margin-bottom: 1.25rem;
    --game-subtitle-size: 1.125rem;
    --game-date-note-margin-top: 0.75rem;
    --game-car-padding: 0.75rem 0.375rem 2.75rem;
    --game-track-gap: 1.75rem;
    --game-card-width: 17.5rem;
    --game-card-height: 24.5rem;
    --game-card-radius: 1.375rem;
    --game-card-padding: 1rem;
    --game-card-border: 1px solid #eadccf;
    --game-card-bg: #f9f5ef;
    --game-card-ink: #3e2c23;
    --game-card-ink-soft: #6b5243;
    --game-card-name-ink: #3e2c23;
    --game-card-on-dark: #f9f5ef;
    --game-card-shadow: inset 0 1px 0 rgb(249 245 239), 0 18px 40px rgb(62 44 35 / 0.16), 0 4px 10px rgb(62 44 35 / 0.08);
    --game-card-lift: -0.5rem;
    --game-card-shadow-hover: 0 0 0 1px rgb(246 211 174 / 0.7), 0 26px 50px rgb(62 44 35 / 0.22);
    --game-card-shadow-on: 0 0 0 1px rgb(246 211 174 / 0.6), 0 0 26px rgb(246 211 174 / 0.3), 0 18px 40px rgb(62 44 35 / 0.16);
    --game-card-outline-width: 0.1875rem;
    --game-card-outline-offset: 0.25rem;
    --game-pip-size: 3.25rem;
    --game-pip-radius: 0.8125rem;
    --game-pip-shadow: 0 6px 14px rgb(62 44 35 / 0.22);
    --game-pip-inset: 0.875rem;
    --game-pip-bg: #eadccf;
    --game-pip-ink: #3e2c23;
    --game-pip-line: #cbb8a4;
    --game-pip-xgrid-size: 0.625rem;
    --game-pip-xgrid-gap: 0.125rem;
    --game-pip-sudoku-size: 1.75rem;
    --game-pip-hello-size: 1.5rem;
    --game-face-width: 12.75rem;
    --game-face-height: 14.75rem;
    --game-face-header-height: 6rem;
    --game-face-padding: 1.125rem 1rem;
    --game-wordmark-max-width: 10.5rem;
    --game-wordmark-max-height: 3.75rem;
    --game-serif-name-size: 2.5rem;
    --game-desc-margin-top: 0.375rem;
    --game-desc-size: 0.875rem;
    --game-status-gap: 0.375rem;
    --game-status-size: 0.8125rem;
    --game-status-padding: 0.25rem 0.625rem;
    --game-status-ink: #3e2c23;
    --game-status-border: #cbb8a4;
    --game-status-bg: #f9f5ef;
    --game-demo-border: #cbb8a4;
    --game-demo-top: 6.5rem;
    --game-demo-vialo-grid-gap: 0.375rem;
    --game-demo-vialo-row-gap: 0.3125rem;
    --game-demo-vialo-cell-size: 1.75rem;
    --game-demo-vialo-cell-border: 1.5px;
    --game-demo-vialo-font-size: 0.8125rem;
    --game-demo-vialo-cell-bg: #f9f5ef;
    --game-demo-tachyyy-width: 10.625rem;
    --game-demo-tachyyy-radius: 0.75rem;
    --game-demo-tachyyy-padding: 0.625rem;
    --game-demo-tachyyy-font-size: 0.75rem;
    --game-demo-tachyyy-gap: 0.375rem;
    --game-demo-tachyyy-bar-height: 0.375rem;
    --game-demo-tachyyy-choice-padding: 0.1875rem 0.5rem;
    --game-demo-tachyyy-bg: #f9f5ef;
    --game-demo-piccline-cell-size: 1.875rem;
    --game-demo-piccline-gap: 0.25rem;
    --game-demo-piccline-font-size: 0.875rem;
    --game-demo-piccline-line-height: 1.875rem;
    --game-demo-piccline-stroke: 9;
    --game-demo-crossword-cell-size: 1.75rem;
    --game-demo-crossword-gap: 0.125rem;
    --game-demo-crossword-font-size: 0.8125rem;
    --game-demo-crossword-bg: #f9f5ef;
    --game-demo-sudoku-cell-size: 2.125rem;
    --game-demo-sudoku-border: 2px;
    --game-demo-sudoku-font-size: 1.0625rem;
    --game-demo-sudoku-bg: #f9f5ef;
    --game-demo-hello-perspective: 500px;
    --game-demo-hello-width: 9.375rem;
    --game-demo-hello-height: 6rem;
    --game-demo-hello-radius: 0.75rem;
    --game-demo-hello-padding: 0.5rem;
    --game-demo-hello-font-size: 0.8125rem;
  }

  .games-section {
    max-width: var(--game-section-max-width);
    margin: 0 auto;
    padding: var(--game-section-padding);
    box-sizing: border-box;
  }

  @media (max-width: 40em) {
    .games-section {
      padding: var(--game-section-padding-phone);
    }
  }

  .games-container {
    display: flex;
    flex-direction: column;
    gap: var(--game-container-gap);
    width: 100%;
  }

  .games-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "heading heading"
      "subtitle subtitle"
      "prev next";
    align-items: center;
    justify-items: center;
    gap: var(--game-header-gap);
  }

  .games-nav-slot {
    display: flex;
    align-items: center;
  }

  .games-nav-prev {
    grid-area: prev;
    justify-self: end;
  }

  .games-nav-next {
    grid-area: next;
    justify-self: start;
  }

  .gs-nav {
    width: var(--game-nav-size);
    height: var(--game-nav-size);
    min-width: var(--game-nav-size);
    min-height: var(--game-nav-size);
    border-radius: var(--radius-pill);
    border: var(--border-hairline) solid var(--game-nav-border);
    background: var(--game-nav-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    color: var(--color-ink);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .gs-nav:hover {
    background: var(--game-nav-bg-hover);
  }

  .gs-nav:focus-visible {
    outline: var(--game-nav-outline-width) solid var(--color-copper-deep);
    outline-offset: var(--game-nav-outline-offset);
  }

  .games-heading {
    grid-area: heading;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--game-heading-size-min), 6vw, var(--game-heading-size-max));
    line-height: 1.1;
    text-align: center;
    color: var(--color-ink);
    font-weight: 700;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .games-subtitle {
    grid-area: subtitle;
    margin: 0 0 var(--game-subtitle-margin-bottom);
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--game-subtitle-size);
    line-height: 1.5;
    color: var(--color-ink-soft);
    min-width: 0;
  }

  @media (min-width: 48em) {
    .games-header {
      grid-template-columns: minmax(auto, var(--game-nav-size)) minmax(0, 1fr) minmax(auto, var(--game-nav-size));
      grid-template-areas:
        "prev heading next"
        "subtitle subtitle subtitle";
    }

    .games-nav-prev {
      justify-self: start;
    }

    .games-nav-next {
      justify-self: end;
    }
  }

  .games-date-note {
    margin: var(--game-date-note-margin-top) 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-ink-soft);
  }

  /* Carousel structure */
  .gcar {
    overflow: hidden;
    padding: var(--game-car-padding);
    touch-action: pan-y;
    max-width: 100%;
  }

  .gtrack {
    display: flex;
    gap: var(--game-track-gap);
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  /* Playing Card Style (280x392) */
  .gcard {
    flex: 0 0 auto;
    position: relative;
    width: var(--game-card-width);
    height: var(--game-card-height);
    box-sizing: border-box;
    border-radius: var(--game-card-radius);
    padding: var(--game-card-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--game-card-ink);
    background: var(--game-card-bg);
    border: var(--game-card-border);
    box-shadow: var(--game-card-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .gcard:hover,
  .gcard:focus-visible {
    transform: translateY(var(--game-card-lift));
    border-color: var(--color-copper-glow);
    box-shadow: var(--game-card-shadow-hover);
  }

  .gcard:focus-visible {
    outline: var(--game-card-outline-width) solid var(--color-copper-deep);
    outline-offset: var(--game-card-outline-offset);
  }

  .gcard.on {
    border-color: var(--color-copper-glow);
    box-shadow: var(--game-card-shadow-on);
  }

  /* Pips */
  .gpip {
    position: absolute;
    width: var(--game-pip-size);
    height: var(--game-pip-size);
    border-radius: var(--game-pip-radius);
    box-shadow: var(--game-pip-shadow);
  }

  .gpip.tl {
    top: var(--game-pip-inset);
    left: var(--game-pip-inset);
  }

  .gpip.br {
    bottom: var(--game-pip-inset);
    right: var(--game-pip-inset);
    transform: rotate(180deg);
  }

  .gpip-crossword {
    background: var(--game-pip-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pip-xgrid {
    display: grid;
    grid-template-columns: repeat(3, var(--game-pip-xgrid-size));
    gap: var(--game-pip-xgrid-gap);
  }

  .pip-xcell-dark {
