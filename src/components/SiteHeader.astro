---
import AccountCorner from './AccountCorner.astro';
import SiteMenu from './SiteMenu.astro';
import SiteNav from './SiteNav.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../config/site';

interface Props {
  /** Study screens: the same corners, kept quiet (no frosted circles). */
  quiet?: boolean;
  /** Home uses the two-row board header. Other pages use the existing sticky or quiet header. */
  overlay?: boolean;
  /** The page's accounts gate is closed: the account corner stays signed out and never loads Supabase. */
  accountsOff?: boolean;
}

const { quiet = false, overlay = false, accountsOff = false } = Astro.props;
// Redesign P2: from the large breakpoint up, pages that aren't study screens show the persistent pill between the
// logo and the account corner (SiteNav.astro). Study screens keep the quiet corners only, and below that breakpoint
// the ☰ panel stays the menu, so nothing changes on phones and tablets.
const bar = !quiet;
---

<header
  data-scroll-header={overlay ? undefined : ''}
  class:list={[
    'z-20 flex w-full items-center gap-(--header-corner-gap) px-(--header-inline-gutter) py-4',
    // With enlarged text the pill can be wider than the screen: let the bar wrap onto a second row, never scroll sideways.
    bar && 'lg:flex-wrap',
    overlay ? 'home-board-header relative' : 'sticky top-0 site-header-sticky',
  ]}
>
  <!-- ☰ in the top-left corner, the account in the top-right (D-46). -->
  <div class:list={['flex flex-1 justify-start', overlay && 'home-menu', bar && 'lg:flex-none']}>
    <SiteMenu quiet={quiet} />
  </div>
  {
    overlay ? (
      <a href="/" aria-label={`${site.name} home`} class="home-brand justify-self-center">
        <Wordmark class="home-brand-art" sizes="(max-width: 639px) 7.5rem, 10.25rem" />
      </a>
    ) : (
      <a href="/" class="p-(--logo-clear) text-ink" aria-label={`${site.name} home`}>
        {/*
          Padding keeps the brand guide's clear space (0.25 × the letter c) around the logo. Study screens get the
          compact emblem (guide §6.1: small, unobtrusive branding during study). Other pages get the full logo at
          240px (guide §3.5) where it fits beside the two corner buttons, and the emblem on phones, where 240px plus
          the corners, gaps and gutters would be wider than the screen.
          The full logo loads lazily (performance, 2026-11-19): phones hide it, and a hidden lazy picture is never
          downloaded, so a phone no longer fetches both 960px full-logo files (about 70 KB) it never shows. From 640px
          the shown copy loads as soon as the page is laid out. The phone emblem stays eager.
        */}
        {quiet ? (
          <Wordmark loading="eager" variant="emblem" class="w-(--logo-emblem)" sizes="2.25rem" />
        ) : (
          <>
            <Wordmark loading="eager" variant="emblem" class="w-(--logo-emblem) sm:hidden" sizes="2.25rem" />
            <Wordmark class="hidden w-(--logo-width) sm:block" sizes="15rem" />
          </>
        )}
      </a>
    )
  }
  {
    bar && (
      <div class:list={[overlay ? 'home-menu-bar min-w-0' : 'hidden min-w-0 lg:flex lg:flex-1 lg:justify-center']}>
        <SiteNav home={overlay} />
      </div>
    )
  }
  <div class:list={['flex flex-1 justify-end', overlay && 'home-account', bar && 'lg:flex-none']}>
    <AccountCorner quiet={quiet} accountsOff={accountsOff} />
  </div>
</header>

<!-- Home stays in normal flow; other headers retain their sticky reading controls. -->
<style>
  header.home-board-header {
    display: grid;
    --home-utilities-width: calc(2 * var(--tap-min) + var(--header-corner-gap));
    grid-template-columns: minmax(var(--home-utilities-width), 1fr) minmax(0, max-content) minmax(var(--home-utilities-width), 1fr);
    align-items: center;
    row-gap: var(--spacing);
  }
  .home-brand { grid-area: 1 / 2; width: var(--home-header-brand-width); max-width: 100%; }
  .home-brand :global(.home-brand-art) { display: block; width: 100%; }
  .home-menu { grid-area: 1 / 1; }
  .home-menu-bar, .home-menu-bar :global([data-site-nav]) { display: contents; }
  .home-menu-bar :global(nav) { grid-area: 2 / 2; justify-self: center; }
  .home-menu-bar :global([data-menu-search]) { grid-area: 2 / 3; justify-self: end; margin-inline-end: calc(var(--tap-min) + var(--header-corner-gap)); }
  .home-account { grid-area: 2 / 3; justify-self: end; }
  @media (min-width: 40rem) {
    .home-menu :global([data-menu-open]) { display: none; }
  }
  @media (width < 40rem) {
    .home-menu-bar :global(nav) { display: none; }
    .home-account, .home-menu-bar :global([data-menu-search]) { grid-row: 1; }
  }

  header.site-header-sticky {
    /* The page tint stays legible in both palettes. The existing glass opacity and blur are shared tokens. */
    background-color: var(--color-page);
    background-color: rgb(from var(--color-page) r g b / var(--panel-alpha));
    -webkit-backdrop-filter: blur(var(--blur-veil));
    backdrop-filter: blur(var(--blur-veil));
    box-shadow: var(--shadow-soft);
    /* Task 77 supplies these motion tokens; use its documented values until it merges. */
    transition: transform var(--duration-base, 240ms) var(--ease-soft, ease);
  }

  header.site-header-sticky.is-tucked {
    transform: translateY(-100%);
    pointer-events: none;
  }

  /*
   * Keep scrollIntoView, keyboard focus and in-page links below the sticky home link.
   * The clearances include the logo, its clear space, py-4 and a little breathing room.
   * Phone: 28 spacing units (112px); sm and larger: 36 units (144px).
   * Home's absolute overlay has no data-scroll-header, so it keeps its normal scroll behavior.
   */
  :global(html:has([data-scroll-header])) {
    scroll-padding-top: calc(var(--spacing) * 28);
  }

  @media (min-width: 40rem) {
    :global(html:has([data-scroll-header])) {
      scroll-padding-top: calc(var(--spacing) * 36);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header.site-header-sticky,
    header.site-header-sticky.is-tucked {
      transform: none;
      transition: none;
    }

    header.site-header-sticky.is-tucked {
      pointer-events: auto;
    }
  }
</style>

<script>
  import { nextHeaderState, type HeaderState } from '../scripts/headerscroll';

  const header = document.querySelector<HTMLElement>('[data-scroll-header]');
  if (header) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const menuDialog = header.querySelector<HTMLDialogElement>('#site-menu');
    const menuButton = header.querySelector<HTMLButtonElement>('[data-menu-open]');
    const accountButton = header.querySelector<HTMLButtonElement>('[data-account-toggle]');
    let previous: HeaderState = 'visible';
    let lastY = Math.max(0, window.scrollY);

    const refresh = () => {
      const scrollY = Math.max(0, window.scrollY);
      const focusInside = header.contains(document.activeElement);
      // Safari may leave a clicked account button unfocused. Its expanded state still keeps the header visible.
      const menuOpen = menuDialog?.open === true
        || menuButton?.getAttribute('aria-expanded') === 'true'
        || accountButton?.getAttribute('aria-expanded') === 'true';
      previous = reducedMotion.matches
        ? 'visible'
        : nextHeaderState(previous, scrollY, lastY, focusInside, menuOpen);
      header.classList.toggle('is-tucked', previous === 'hidden');
      lastY = scrollY;
    };

    window.addEventListener('scroll', refresh, { passive: true });
    header.addEventListener('focusin', refresh);
    // Let focus settle on its new target before deciding whether the header may tuck away.
    header.addEventListener('focusout', () => requestAnimationFrame(() => {
      // Leaving the header at the same scroll position is still a downward navigation event for the sticky chrome.
      // Give the state helper a one-pixel delta so it can tuck the header without waiting for another wheel/touch move.
      lastY = Math.max(0, window.scrollY - 1);
      refresh();
    }));
    // The menu is a native dialog, which can move focus away from its opening button.
    menuDialog?.addEventListener('toggle', refresh);
    menuDialog?.addEventListener('close', refresh);
    menuButton?.addEventListener('click', () => requestAnimationFrame(refresh));
    accountButton?.addEventListener('click', () => requestAnimationFrame(refresh));
    reducedMotion.addEventListener('change', refresh);
    refresh();
  }
</script>
