---
/**
 * Cueory brand wordmark, using the high-resolution PNG assets created in Task 1 (D-47, D-49).
 * Two variants:
 * - full: the rounded flask + lowercase "cueory"
 * - emblem: the flask alone, for small screens, avatars and tight headers
 * Both render as an image, with an optional accessible label when no surrounding text names the site.
 */
interface Props {
  variant?: 'full' | 'emblem';
  /** Responsive sizes attribute; defaults to a sensible cap for each variant. */
  sizes?: string;
  /** Accessible name, when nothing around the logo names the brand. */
  label?: string;
  /** Loading priority for the rendered brand artwork. Header and hero marks stay eager, footer marks can be lazy. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const files = {
  full: { name: 'wordmark', widths: [240, 480, 960], width: 960, height: 280 },
  emblem: { name: 'emblem', widths: [96, 192, 384], width: 384, height: 428 },
} as const;

const { variant = 'full', sizes, label, class: className, loading = 'lazy' } = Astro.props;
const art = files[variant];
const path = (mode: 'light' | 'dark', width: number) => `/brand/v1/${art.name}-${mode}-${width}.png`;
const srcset = (mode: 'light' | 'dark') => art.widths.map((width) => `${path(mode, width)} ${width}w`).join(', ');

const shownAt = sizes ?? (variant === 'full' ? '(min-width: 640px) 240px, 180px' : '40px');
---

<span class:list={['wordmark inline-block leading-none', className]}>
  {label && <span class="sr-only">{label}</span>}
  <img
    src={path('light', art.widths[0])}
    srcset={srcset('light')}
    sizes={shownAt}
    width={art.width}
    height={art.height}
    alt=""
    aria-hidden="true"
    loading={loading}
    data-image-priority={loading === 'eager' ? 'header' : undefined}
    decoding="async"
    draggable="false"
    class="dark:hidden max-w-full h-auto align-middle"
  />
  <img
    src={path('dark', art.widths[0])}
    srcset={srcset('dark')}
    sizes={shownAt}
    width={art.width}
    height={art.height}
    alt=""
    aria-hidden="true"
    loading={loading}
    data-image-priority={loading === 'eager' ? 'header' : undefined}
    decoding="async"
    draggable="false"
    class="hidden dark:inline-block max-w-full h-auto align-middle"
  />
</span>
