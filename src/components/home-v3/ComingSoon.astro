---
/**
 * Home v3 "coming soon" section (docs/design/home-v3/, boards home-*): one frosted panel with the heading, one line
 * about what is next, the email field and the copper "join the list" button. Same Kit form as the rest of the site:
 * a plain HTML form that posts straight to Kit (no Kit script), with Kit's landing page link or "sign ups open soon."
 * as the fallbacks (signupState in src/config/site.ts). Wide screens and phone landscape put the words and the form on
 * one row (the boards' flex rules: the words and the field share the free room, the button keeps its size), phones
 * stack them. The privacy line the boards do not have sits as one small centred line under the panel, so the panel
 * itself keeps the board's size. Lowercase brand voice (D-47).
 */
import { kitFormAction, kitLandingUrl, newsletter, signupState } from '../../config/site';

const state = signupState(newsletter.formAction, newsletter.landingUrl);
const ready = state === 'form';
const landingUrl = kitLandingUrl(newsletter.landingUrl);
---

<section id="signup" class="soon-section scroll-mt-section" aria-labelledby="soon-heading" data-coming-soon>
  <div class="soon-card veil" data-reveal-section>
    <div class="soon-copy">
      <h2 id="soon-heading" class="display soon-heading">coming soon</h2>
      <p class="soon-line">Mental Health I and Med Math are next. Get one email when they open.</p>
    </div>
    {
      ready ? (
        <form
          action={kitFormAction(newsletter.formAction)}
          method="post"
          class="soon-form"
          data-testid="soon-form"
        >
          <label for="soon-email" class="sr-only">
            email address
          </label>
          <input
            id="soon-email"
            name={newsletter.emailFieldName}
            type="email"
            required
            maxlength="254"
            autocomplete="email"
            inputmode="email"
            aria-describedby="soon-help"
            placeholder="your email"
            class="soon-input"
          />
          <button type="submit" class="copper-button soon-button">join the list</button>
        </form>
      ) : state === 'landing' ? (
        <a
          href={landingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="copper-button soon-button soon-link"
          aria-label="get launch updates (opens in a new tab)"
          data-testid="soon-landing"
        >
          get launch updates
        </a>
      ) : (
        <p class="soon-line" data-testid="soon-pending">sign ups open soon.</p>
      )
    }
  </div>
  {
    ready ? (
      <p id="soon-help" class="soon-help" data-testid="soon-help">
        a few emails about new lessons and the launch. unsubscribe any time. emails are sent by {newsletter.provider}; see
        our <a href="/privacy">privacy page</a>.
      </p>
    ) : state === 'landing' ? (
      <p class="soon-help" data-testid="soon-help">
        you sign up on {newsletter.provider}'s page; see our <a href="/privacy">privacy page</a>.
      </p>
    ) : null
  }
</section>

<style>
  /* The board's space above the panel (28 px on a phone, 40 px on a wider screen, 24 px on a phone turned sideways);
     the social row under it brings its own. */
  .soon-section {
    margin-block: calc(var(--spacing) * 7) 0;
    padding-inline: calc(var(--spacing) * 4);
  }

  /* Phone: the words, the field and the button each take a full row. */
  .soon-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    max-inline-size: var(--soon-card-max-width);
    margin-inline: auto;
    padding: calc(var(--spacing) * 5.5);
    border-color: var(--cueory-glass-border);
    border-radius: var(--soon-radius-phone);
  }

  .soon-copy {
    flex: 1 1 100%;
    min-inline-size: 0;
  }

  .soon-heading {
    font-size: var(--soon-heading-phone);
    line-height: var(--soon-heading-line);
    overflow-wrap: break-word;
  }

  .soon-line {
    margin-block-start: calc(var(--spacing) * 1.5);
    font-size: var(--soon-line-size);
    line-height: var(--soon-line-height);
    color: var(--color-ink-soft);
  }

  .soon-form {
    display: flex;
    flex-wrap: wrap;
    flex: 1 1 100%;
    gap: calc(var(--spacing) * 3);
    min-inline-size: 0;
  }

  .soon-input {
    flex: 1 1 100%;
    box-sizing: border-box;
    min-inline-size: 0;
    min-block-size: var(--soon-input-height);
    padding-inline: calc(var(--spacing) * 4);
    border: var(--border-soon-input) solid var(--color-control);
    border-radius: var(--radius-pill);
    background-color: var(--color-page);
    color: var(--color-ink);
  }

  .soon-button {
    flex: 1 1 100%;
    min-block-size: calc(var(--spacing) * 12);
    padding-block: 0;
    padding-inline: calc(var(--spacing) * 6);
    font-weight: 700;
    /* The shared copper gradient starts inside the 1 px transparent border, so it repeats there and shows a copper
       sliver at the pill's right end: draw it from the border edge instead. */
    background-origin: border-box;
    background-repeat: no-repeat;
  }

  /* The privacy line: one small centred line under the panel (it wraps to a few lines on a phone). */
  .soon-help {
    max-inline-size: var(--soon-card-max-width);
    margin-inline: auto;
    margin-block-start: calc(var(--spacing) * 1.5);
    color: var(--color-ink-soft);
    font-size: var(--soon-help-size);
    line-height: var(--soon-help-line);
    text-align: center;
  }

  .soon-help a {
    color: var(--color-ink);
  }

  /* Tablet and desktop: the words, the field and the button on one row. The words (basis 300) and the form (basis 404.5:
     a 254 px field, the 16 px gap and the 134.5 px button) share what is left, as the board's flex rules do. */
  @media (min-width: 40em) {
    .soon-section {
      margin-block-start: calc(var(--spacing) * 10);
      padding-inline: var(--spacing-gutter);
    }

    .soon-card {
      gap: calc(var(--spacing) * 4);
      padding: calc(var(--spacing) * 8);
      border-radius: var(--soon-radius);
    }

    .soon-copy {
      flex: 1 1 var(--soon-copy-basis);
    }

    .soon-form {
      flex-wrap: nowrap;
      flex: 1 1 var(--soon-form-basis);
      gap: calc(var(--spacing) * 4);
    }

    .soon-input {
      flex: 1 1 0;
    }

    .soon-button {
      flex: 0 0 auto;
      padding-inline: calc(var(--spacing) * 5.5);
    }

    .soon-heading {
      font-size: var(--soon-heading);
    }
  }

  /* Phone landscape (844 x 390): the board's compact single row. */
  @media (orientation: landscape) and (max-height: 32em) {
    .soon-section {
      margin-block-start: calc(var(--spacing) * 6);
    }

    .soon-card {
      flex-wrap: nowrap;
      max-inline-size: var(--soon-card-max-width-landscape);
      padding: calc(var(--spacing) * 4.5) calc(var(--spacing) * 5);
      gap: calc(var(--spacing) * 3);
      border-radius: var(--soon-radius-landscape);
    }

    .soon-copy {
      flex: 1 1 auto;
    }

    .soon-form {
      flex: 0 0 auto;
      gap: calc(var(--spacing) * 3);
    }

    .soon-help {
      max-inline-size: var(--soon-card-max-width-landscape);
    }

    .soon-heading {
      font-size: var(--soon-heading-landscape);
    }

    .soon-line {
      font-size: var(--soon-line-size-landscape);
      line-height: var(--soon-line-height-landscape);
    }

    .soon-input {
      flex: 0 0 var(--soon-input-width-landscape);
      min-block-size: var(--tap-min);
      font-size: var(--text-sm);
    }

    .soon-button {
      min-block-size: var(--tap-min);
      padding-inline: calc(var(--spacing) * 4.5);
      font-size: var(--text-sm);
    }
  }
</style>
