---
import Wordmark from './Wordmark.astro';
import ExploreDock from './ExploreDock.astro';
import { site } from '../config/site';
import { heroStartHref } from '../lessons/draftgate';

/**
 * The home hero (redesign P5, renderings HomeV2-1.png and HomeV2-390.png; copy: docs/design/copy-deck.md, "/ (HomeV2)",
 * ship column). Layout: the logo, Christian's motto, the headline with "simpler." in copper, the "start studying for
 * free" call to action, the value points, the Ko-fi support card, the anatomy figure and the "explore" row.
 *
 * Settled rules that win over the picture:
 * - The call to action follows the draft gate (heroStartHref in src/lessons/draftgate.ts, the same answer the menu and
 *   the library use): where a lesson is open (staging, previews, local and test builds) it is a copper link to it; in the
 *   live build, which holds the sample lesson back, it is a disabled button tagged "coming soon", never a link that leads
 *   nowhere (copy-deck, hero button). Once a real lesson is open live, the guard's answer changes and so does this button.
 * - The third value point ("adhd friendly / less overwhelm, more focus") is shipped: Christian approved it on 23 Nov (D-190).
 * - Final board (home-v2.dc.html, 20 Nov): phones and tablets are one centered column; from the xl width (80rem) the hero is
 *   two columns: the text column (every item centered on its middle line) right of the old position, the larger figure on
 *   the right with its halo ring, fading out to the left so the text sits on clean background.
 * - The headline is two natural lines on phones, capped near 48 px, so the button and value points show on the first screen.
 * - Where the start button is closed (live build) it looks muted and a working "play today's games" link sits beside it.
 * - The accent words and the motto are upright (brand guide: accent lines are never italic or script).
 * - The explore dock (ExploreDock.astro) now includes "resources": the page exists, and its live build is a plain coming-soon page.
 * - "give us suggestions" goes to /message (email only, no form yet).
 */
const startHref = heroStartHref();
---

<section
  class="scene scene-hero relative overflow-hidden pb-section"
  aria-labelledby="hero-heading"
>
  <div class="relative mx-auto flex w-full max-w-(--container-explore) flex-col px-gutter xl:static pt-(--hero-top-clear) max-xl:pb-section xl:min-h-(--hero-min-height)">
    <!--
      The home header is two corner buttons laid over the top of the page (Layout.astro), so the hero draws its own logo
      beside the menu button: the emblem on phones, the full logo from 640 px wide, as the other pages' headers do.
    -->
    {/*
      The full logo loads lazily (performance, 2026-11-19): phones hide it, and a hidden lazy picture is never
      downloaded, so a phone no longer fetches both 960px full-logo files (about 73 KB) it never shows. From 640px the
      shown copy loads as soon as the page is laid out. The phone emblem stays eager.
    */}
    <div class="hero-logo-row flex items-center justify-center sm:justify-start sm:ps-(--hero-logo-inset)">
      <Wordmark loading="eager" variant="emblem" class="w-(--logo-emblem) sm:hidden" sizes="2.25rem" />
      <Wordmark
        class="hidden w-(--logo-width) sm:block"
        sizes="15rem"
        preloadBothOnDesktop
      />
    </div>

    <!-- A size container: the headline's size follows the text column's width, so its longer line always fits. -->
    <div class="@container relative z-10 mx-auto mt-(--hero-eyebrow-gap) w-full max-w-(--container-hero-copy) text-center xl:ms-(--hero-copy-offset) xl:me-0 xl:max-w-(--hero-copy-width)">
      <p class="hero-eyebrow flex items-center justify-center gap-3 text-ink-soft xl:gap-(--hero-eyebrow-gap-xl) xl:text-lg">
        <span class="hidden h-px w-10 shrink-0 bg-control sm:block xl:w-(--hero-eyebrow-rule)" aria-hidden="true"></span>
        <span>by nursing students, for nursing students</span>
        <span class="hidden h-px w-10 shrink-0 bg-control sm:block xl:w-(--hero-eyebrow-rule)" aria-hidden="true"></span>
      </p>
      <h1 id="hero-heading" class="display mt-6 text-display-hero-phone wrap-break-word sm:text-display-hero xl:text-display-hero-xl xl:tracking-tight">
        nursing school made <span class="hero-accent">simpler.</span>
      </h1>
      <svg class="hero-curve xl:w-(--hero-curve-width) xl:translate-x-(--hero-curve-shift)" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M2 14 C 80 2, 190 2, 298 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>

      <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
        {
          startHref ? (
            <span class="hero-start-ring">
              <span class="hero-start-light" aria-hidden="true"></span>
              <a
                href={startHref}
                class="copper-button text-center font-bold"
                data-testid="hero-start"
              >
                start studying for free <span aria-hidden="true">→</span>
              </a>
            </span>
          ) : (
            <span class="flex flex-wrap items-center justify-center gap-3">
              <button
                type="button"
                class="copper-button text-center font-bold"
                aria-disabled="true"
                aria-describedby="hero-start-soon"
                data-testid="hero-start"
              >
                start studying for free <span aria-hidden="true">→</span>
              </button>
              <span id="hero-start-soon" class="hero-soon">coming soon</span>
            </span>
          )
        }
        <a href="/play" class="hero-secondary-link" data-testid="hero-play-games">
          play today's games <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Decorative: the figure carries no information the text doesn't. It is the first thing on the page, so it loads at once. -->
    <div class="hero-figure-wrap mx-auto mt-10 w-(--hero-figure-phone) xl:absolute xl:end-(--hero-figure-end) xl:top-(--hero-figure-top) xl:z-0 xl:mt-0 xl:h-(--hero-figure-height) xl:w-(--hero-figure-width)" aria-hidden="true">
      <img
        src="/design/home-v2/hero-figure-halo.webp"
        alt=""
        aria-hidden="true"
        data-image-priority="hero"
        width="673"
        height="692"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        draggable="false"
        class="hero-figure block h-auto w-full xl:h-full xl:object-cover xl:object-right-top"
      />
      <span class="hero-halo hidden xl:block"></span>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-(--container-hero-copy) text-center xl:ms-(--hero-copy-offset) xl:me-0 xl:max-w-(--hero-copy-width)">
      <ul class="mx-auto mt-10 grid w-fit gap-5 sm:w-auto sm:grid-cols-3 xl:ms-(--hero-points-start) xl:w-(--hero-points-width) xl:-translate-x-1/2" aria-label="what you get">
        <li class="flex items-start gap-3 text-ink sm:justify-center">
          <svg class="hero-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3 3 8l9 5 9-5-9-5Z M3 12l9 5 9-5 M3 16l9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
          <span class="flex flex-col text-start">
            <strong class="font-bold">structured learning</strong>
            <span class="text-base text-ink-soft xl:text-sm">from basics to med-surg</span>
          </span>
        </li>
        <li class="flex items-start gap-3 text-ink sm:justify-center sm:border-s sm:border-line sm:ps-5 " data-hero-point-rule>
          <svg class="hero-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" />
          </svg>
          <span class="flex flex-col text-start">
            <strong class="font-bold">multiple ways to study</strong>
            <span class="text-base text-ink-soft xl:text-sm">learn the way that works for you</span>
          </span>
        </li>
        <li class="flex items-start gap-3 text-ink sm:justify-center sm:border-s sm:border-line sm:ps-5 " data-hero-point-rule>
          <svg class="hero-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3c.6 5 3.4 8.4 9 9-5.6.6-8.4 4-9 9-.6-5-3.4-8.4-9-9 5.6-.6 8.4-4 9-9Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
          <span class="flex flex-col text-start">
            <strong class="font-bold">adhd friendly</strong>
            <span class="text-base text-ink-soft xl:text-sm">less overwhelm, more focus</span>
          </span>
        </li>
      </ul>

      {
        site.tipPageUrl && (
          <a
            href={site.tipPageUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-support mx-auto mt-10 flex max-w-(--container-hero-card) flex-wrap items-center gap-4 text-start p-4 text-ink no-underline sm:flex-nowrap"
            data-testid="hero-support"
            data-new-tab-cue
          >
            <!-- The Ko-fi cup: a filled copper cup with a heart, the handle on the right (drawn like the rendering's mark). -->
            <svg class="hero-icon-mug hero-icon-copper" viewBox="0 0 32 24" aria-hidden="true" focusable="false">
              <path d="M3 6h20v8a8 8 0 0 1-8 8H11a8 8 0 0 1-8-8V6Z" fill="currentColor" />
              <path d="M23 8h2.5a4 4 0 0 1 0 8H23" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <path d="M13 17.4 8.8 13.3a2.5 2.5 0 0 1 3.5-3.5l.7.7.7-.7a2.5 2.5 0 0 1 3.5 3.5L13 17.4Z" class="hero-icon-mug-heart" />
            </svg>
            <span class="flex flex-col text-start">
              <span class="text-base text-ink-soft xl:text-sm">support on</span>
              <strong class="text-lg font-bold">Ko-fi</strong>
            </span>
            <span class="hero-support-body order-last basis-full text-base sm:order-none sm:basis-0 sm:border-s sm:border-control sm:ps-4">
              support our mission to expand our resources, help nursing students struggling in class, and keep building ways we can help students and nurses.
              <span class="sr-only"> (opens in a new tab)</span>
            </span>
            <svg class="hero-icon ms-auto shrink-0 sm:ms-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14 4h6v6 M20 4 11 13 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <ExploreDock />
</section>
