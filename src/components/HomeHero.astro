---
import Wordmark from './Wordmark.astro';
import { site } from '../config/site';
import { heroStartHref } from '../lessons/draftgate';

/**
 * The home hero (redesign P5, renderings HomeV2-1.png and HomeV2-390.png; copy: docs/design/copy-deck.md, "/ (HomeV2)",
 * ship column). Layout: the logo, Christian's motto, the headline with "simpler." in copper, the "start studying for
 * free" call to action, the value points, the Ko-fi support card, the anatomy figure and the "explore" row.
 *
 * Settled rules that win over the picture:
 * - The call to action follows the draft gate (heroStartHref in src/lessons/draftgate.ts, the same answer the menu and
 *   the library use): where a lesson is open (staging, previews, local and test builds) it is a copper link to it; in the
 *   live build, which holds the sample lesson back, it is a disabled button tagged "coming soon", never a link that leads
 *   nowhere (copy-deck, hero button). Once a real lesson is open live, the guard's answer changes and so does this button.
 * - The third value point ("adhd friendly") is held: there is no support for the claim yet.
 * - The accent words and the motto are upright (brand guide: accent lines are never italic or script).
 * - "resources" is left out of the explore row until /resources is live (its live build is a plain coming-soon page).
 * - "give us suggestions" goes to /message (email only, no form yet).
 */
const exploreTiles = [
  { label: 'lessons', href: '/learn', testid: 'explore-lessons', icon: 'book' },
  { label: 'study materials', href: '#ways-to-study', testid: 'explore-materials', icon: 'layers' },
  { label: 'daily games', href: '/play', testid: 'explore-games', icon: 'games' },
  { label: 'give us suggestions', href: '/message', testid: 'explore-suggestions', icon: 'chat' },
] as const;

const startHref = heroStartHref();
---

<section
  class="scene scene-hero relative overflow-hidden pb-section"
  aria-labelledby="hero-heading"
>
  <div class="relative flex min-h-(--hero-min-height) flex-col px-gutter pt-(--hero-top-clear) lg:min-h-(--hero-min-height)">
    <!--
      The home header is two corner buttons laid over the top of the page (Layout.astro), so the hero draws its own logo
      beside the menu button: the emblem on phones, the full logo from 640 px wide, as the other pages' headers do.
    -->
    <div class="flex items-center ps-(--hero-logo-inset)">
      <Wordmark loading="eager" variant="emblem" class="w-(--logo-emblem) sm:hidden" sizes="2.25rem" />
      <Wordmark loading="eager" class="hidden w-(--logo-width) sm:block" sizes="15rem" />
    </div>

    <!-- A size container: the headline's size follows the text column's width, so its longer line always fits. -->
    <div class="@container relative z-10 mt-(--hero-eyebrow-gap) w-full max-w-(--container-hero-copy)">
      <p class="hero-eyebrow flex items-center gap-3 text-ink-soft">
        <span class="hidden h-px w-10 shrink-0 bg-control sm:block" aria-hidden="true"></span>
        <span>by nursing students, for nursing students</span>
        <span class="hidden h-px min-w-6 flex-1 bg-control sm:block" aria-hidden="true"></span>
      </p>
      <h1 id="hero-heading" class="display mt-6 text-display-hero-phone wrap-break-word sm:text-display-hero">
        <span class="max-sm:block">nursing</span> <span class="max-sm:block">school</span> <span class="max-sm:block">made</span> <span class="hero-accent max-sm:block">simpler.</span>
      </h1>
      <svg class="hero-curve" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M2 14 C 80 2, 190 2, 298 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>

      {
        startHref ? (
          <p class="mt-10">
            <a
              href={startHref}
              class="copper-button text-start font-bold"
              data-testid="hero-start"
            >
              start studying for free <span aria-hidden="true">→</span>
            </a>
          </p>
        ) : (
          <p class="mt-10 flex flex-wrap items-center gap-3">
            <button
              type="button"
              class="copper-button text-start font-bold"
              aria-disabled="true"
              aria-describedby="hero-start-soon"
              data-testid="hero-start"
            >
              start studying for free <span aria-hidden="true">→</span>
            </button>
            <span id="hero-start-soon" class="hero-soon">coming soon</span>
          </p>
        )
      }

      <ul class="mt-10 grid gap-5 sm:grid-cols-2" aria-label="what you get">
        <li class="flex items-start gap-3 text-ink">
          <svg class="hero-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3 3 8l9 5 9-5-9-5Z M3 12l9 5 9-5 M3 16l9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
          <span class="flex flex-col">
            <strong class="font-bold">structured learning</strong>
            <span class="text-sm text-ink-soft">from basics to med-surg</span>
          </span>
        </li>
        <li class="flex items-start gap-3 text-ink sm:border-s sm:border-line sm:ps-5" data-hero-point-rule>
          <svg class="hero-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" />
          </svg>
          <span class="flex flex-col">
            <strong class="font-bold">multiple ways to study</strong>
            <span class="text-sm text-ink-soft">learn the way that works for you</span>
          </span>
        </li>
      </ul>

      {
        site.tipPageUrl && (
          <a
            href={site.tipPageUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-support mt-10 flex max-w-(--container-hero-card) flex-wrap items-center gap-4 p-4 text-ink no-underline sm:flex-nowrap"
            data-testid="hero-support"
          >
            <!-- The Ko-fi cup: a filled copper cup with a heart, the handle on the right (drawn like the rendering's mark). -->
            <svg class="hero-icon-mug hero-icon-copper" viewBox="0 0 32 24" aria-hidden="true" focusable="false">
              <path d="M3 6h20v8a8 8 0 0 1-8 8H11a8 8 0 0 1-8-8V6Z" fill="currentColor" />
              <path d="M23 8h2.5a4 4 0 0 1 0 8H23" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <path d="M13 17.4 8.8 13.3a2.5 2.5 0 0 1 3.5-3.5l.7.7.7-.7a2.5 2.5 0 0 1 3.5 3.5L13 17.4Z" class="hero-icon-mug-heart" />
            </svg>
            <span class="flex flex-col">
              <span class="text-sm text-ink-soft">support on</span>
              <strong class="text-lg font-bold">Ko-fi</strong>
            </span>
            <span class="hero-support-body order-last basis-full text-sm sm:order-none sm:basis-0 sm:border-s sm:border-control sm:ps-4">
              support our mission to expand our resources, help nursing students struggling in class, and keep building ways we can help students and nurses.
              <span class="sr-only"> (opens in a new tab)</span>
            </span>
            <svg class="hero-icon ms-auto shrink-0 sm:ms-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14 4h6v6 M20 4 11 13 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
    </div>

    <!-- Decorative: the figure carries no information the text doesn't. It is the first thing on the page, so it loads at once. -->
    <img
      src="/design/hero-anatomy-figure.webp"
      alt=""
      aria-hidden="true"
      data-image-priority="hero"
      width="673"
      height="692"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      draggable="false"
      class="hero-figure mt-10 ms-auto w-(--hero-figure-phone) lg:absolute lg:end-0 lg:bottom-0 lg:z-0 lg:mt-0 lg:w-(--hero-figure-width)"
    />
  </div>

  <div class="px-gutter">
    <nav class="veil mx-auto flex max-w-(--container-explore) flex-col gap-6 p-6 lg:flex-row lg:items-center lg:gap-10 lg:p-8" aria-labelledby="explore-heading">
      <div class="shrink-0">
        <p class="hero-caps text-sm text-ink-soft">EXPLORE</p>
        <h2 id="explore-heading" class="display mt-2 text-title-explore">start with what you need.</h2>
      </div>
      <ul class="grid flex-1 grid-cols-2 gap-3 sm:grid-cols-4">
        {
          exploreTiles.map((tile) => (
            <li class="flex">
              <a
                href={tile.href}
                class="explore-tile flex w-full flex-col items-center justify-center gap-2 p-4 text-center text-ink no-underline"
                data-testid={tile.testid}
              >
                <svg class="hero-icon-lg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  {tile.icon === 'book' && <path d="M4 5.5C6.5 4 9.5 4 12 5.5 14.5 4 17.5 4 20 5.5V19c-2.5-1.5-5.5-1.5-8 0-2.5-1.5-5.5-1.5-8 0V5.5Z M12 5.5V19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />}
                  {tile.icon === 'layers' && <path d="M12 3 3 8l9 5 9-5-9-5Z M3 12l9 5 9-5 M3 16l9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />}
                  {tile.icon === 'games' && <path d="M4 6h6v6H4Z M14 6h6v6h-6Z M4 15h16v4H4Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />}
                  {tile.icon === 'chat' && <path d="M4 5h16v11H9l-5 4V5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />}
                </svg>
                <span>{tile.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
