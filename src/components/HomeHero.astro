---
import ExploreDock from './ExploreDock.astro';
import { site } from '../config/site';
import { heroStartHref } from '../lessons/draftgate';

const startHref = heroStartHref();
const points = [
  { title: 'structured learning', icon: 'M3 7l9-4 9 4-9 5zM3 12l9 5 9-5M3 17l9 5 9-5' },
  { title: 'multiple ways to study', icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-4 0a5 5 0 1 1-10 0 5 5 0 0 1 10 0Z' },
  { title: 'adhd friendly', icon: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z' },
];
---

<section
  class="scene scene-hero relative overflow-hidden pb-section"
  aria-labelledby="hero-heading"
>
  <div class="relative mx-auto w-full pt-(--hero-top-clear)">
    <div class="home-stage">
  <div class="stage-copy">
    <p class="hero-eyebrow">by nursing students, for nursing students</p>
    <h1 id="hero-heading" class="display">
      nursing school made <span class="stage-word"><span class="hero-accent">simpler.</span><svg class="stage-underline" aria-hidden="true" viewBox="0 0 220 18" preserveAspectRatio="none"><path d="M4 13.5C58 4.5 148 3.5 216 11.5" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/></svg></span>
    </h1>
    <div class="stage-actions">
      {startHref ? (
        <a href={startHref} class="copper-button" data-testid="hero-start">start studying for free <span aria-hidden="true">→</span></a>
      ) : (
        <>
          <button type="button" aria-disabled="true" aria-describedby="hero-start-soon" class="copper-button" data-testid="hero-start">start studying for free <span aria-hidden="true">→</span></button>
          <span id="hero-start-soon" class="hero-soon">coming soon</span>
          <a href="/play" class="hero-secondary-link" data-testid="hero-play-games">play today's games <span aria-hidden="true">→</span></a>
        </>
      )}
    </div>
    <ul class="stage-points" aria-label="what you get">
      {points.map(({title, icon}) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/></svg>{title}</li>)}
    </ul>
  </div>
  <div class="stage-scene">
    <div class="stage-photo" aria-hidden="true"></div>
    <div class="stage-halo" aria-hidden="true"><i></i></div>
    {site.tipPageUrl && <a class="stage-tip" data-testid="hero-support" data-new-tab-cue href={site.tipPageUrl} rel="noopener noreferrer" target="_blank">
      <svg viewBox="0 0 32 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M3 5h18v9a7 7 0 0 1-7 7h-4a7 7 0 0 1-7-7Zm18 2h3a4 4 0 0 1 0 8h-3"/>
        <path d="m12 16-4-4c-2-3 2-5 4-2 2-3 6-1 4 2Z" fill="currentColor"/>
      </svg>
      <span>support on <strong>Ko-fi</strong></span>
      <span class="sr-only">(opens in a new tab)</span>
    </a>}
  </div>
</div>
  </div>

  <ExploreDock />
</section>
<style>
.home-stage {
  position: relative;
  isolation: isolate;
  overflow-x: clip;
  text-align: center;
}
.stage-copy { position: relative; z-index: 2; padding-inline: var(--spacing-gutter); }
.hero-eyebrow, .stage-actions, .stage-points, .stage-points li, .stage-tip { display: flex; align-items: center; justify-content: center; }
.hero-eyebrow { font-size: var(--stage-eyebrow-size); gap: var(--stage-eyebrow-gap); font-family: var(--font-body); font-style: normal; color: var(--color-ink-soft); }
.hero-eyebrow::before, .hero-eyebrow::after { content: ''; inline-size: var(--stage-eyebrow-rule); border-top: var(--stage-hairline) solid var(--color-line); }
h1 { margin: var(--stage-heading-gap) auto 0; max-width: var(--stage-heading-width); font-size: var(--stage-heading-size); font-weight: 700; line-height: 1.08; }
.stage-word { position: relative; display: inline-block; }
.home-stage .hero-accent { color: var(--stage-accent-ink); background: none; -webkit-text-fill-color: currentColor; -webkit-text-stroke-width: var(--stage-accent-stroke); animation: none; }
.stage-underline { position: absolute; inset: auto -2% -.14em; width: 104%; height: .22em; color: var(--color-copper-deep); }
.stage-actions { gap: calc(2 * var(--spacing)); flex-wrap: wrap; margin: var(--stage-action-margin); }
.stage-points { gap: .6em 1em; flex-wrap: wrap; color: var(--color-ink-soft); font-size: var(--stage-points-size); max-width: var(--stage-points-width); margin: var(--stage-points-margin); }
.stage-points li { gap: var(--stage-icon-gap); }
.stage-points svg { width: 1.1em; height: 1.1em; }
.stage-scene { position: relative; width: var(--stage-width); margin: var(--stage-margin); height: var(--stage-height); }
.stage-photo { position: absolute; inset-inline-start: 50%; transform: translateX(-50%); top: var(--stage-photo-top); width: var(--stage-photo-width); aspect-ratio: 2880/1607; background: var(--stage-photo) center / contain no-repeat; mask-image: var(--stage-photo-mask); }
.home-stage { --stage-accent-ink: color-mix(in srgb, var(--color-ink) 75%, var(--color-copper-deep)); --stage-photo: url('/design/home-v3/stage-light.webp'); }
:global(:root[data-theme="dark"]) .home-stage { --stage-accent-ink: color-mix(in srgb, var(--color-copper-glow) 75%, var(--color-copper)); --stage-photo: url('/design/home-v3/stage-evening.webp'); }
@media (prefers-color-scheme: dark) {
  :global(:root:not([data-theme="light"])) .home-stage { --stage-accent-ink: color-mix(in srgb, var(--color-copper-glow) 75%, var(--color-copper)); --stage-photo: url('/design/home-v3/stage-evening.webp'); }
}
.stage-halo { position: absolute; left: 50%; top: var(--stage-halo-top); width: var(--stage-halo-width); aspect-ratio: 1; transform: translate(-50%, -50%); clip-path: inset(0 0 19%); mask-image: radial-gradient(closest-side, transparent 93%, currentColor 96%, currentColor 97%, transparent); pointer-events: none; }
.stage-halo i { display: block; width: 100%; height: 100%; border-radius: 50%; background: conic-gradient(transparent 250deg, var(--color-copper-glow) 325deg, var(--color-copper-shine) 355deg, transparent); }
@media (prefers-reduced-motion: no-preference) { .stage-halo i { animation: stage-orbit 7s linear infinite; } }
@keyframes stage-orbit { to { transform: rotate(1turn); } }
.stage-tip { position: absolute; top: var(--stage-tip-top); bottom: var(--stage-tip-bottom); left: var(--stage-tip-left); transform: var(--stage-tip-offset); gap: var(--stage-point-row-gap); font-size: var(--text-sm); min-height: var(--tap-min); padding: var(--stage-tip-padding); border: var(--stage-hairline) solid var(--color-line); border-radius: 100vw; color: var(--color-ink); background-color: var(--color-page); text-decoration: none; }
.stage-tip svg { width: var(--stage-tip-icon); }
.stage-tip span { line-height: inherit; text-align: start; }
.stage-tip strong { display: block; }
/* The header lies over the top of the page. When the "continue studying" strip is there it sits below the header and the
   hero then starts right under it, so the header never covers the strip. */
:global(main aside[aria-label="continue studying"]) { margin-top: var(--hero-top-clear); }
:global(main:has(aside[aria-label="continue studying"])) .scene-hero > div { padding-top: var(--spacing); }
</style>
