---
import Layout from '../layouts/Layout.astro';

// The live build holds sample and placeholder lessons back (src/lessons/draftgate.ts). Only the address words appear
// here, never the lesson's own text, so the title and description stay neutral and unique for each page.
const label = Astro.url.pathname.replace(/^\/learn\//, '').replace(/\/+$/, '').replaceAll('/', ' · ').replaceAll('-', ' ');
---

<Layout
  title={`coming soon: ${label}`}
  description={`${label} is not open yet and is coming soon to cueory. the daily games are open in the meantime.`}
  variant="study"
  noindex
  promo={false}
>
  <div class="mx-auto max-w-prose pt-8 sm:pt-12" data-pagefind-ignore>
    <h1 class="mt-3 break-words text-2xl">coming soon</h1>
    <p class="mt-3 text-ink-soft" data-testid="lesson-soon">this lesson is coming soon.</p>
    <ul class="mt-section space-y-2 text-sm">
      <li><a href="/learn">back to learn</a></li>
      <li><a href="/play">play the daily games</a></li>
    </ul>
  </div>
</Layout>
