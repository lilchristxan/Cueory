---
/**
 * The fanned card deck at the right edge of a game page (Games v2), at one fixed spot on every game page. One card for
 * each other open game, like a hand of playing cards. The FRONT card is the next game in the loop (config/gamedeck.ts)
 * and says so ("next game ›"); the cards behind it follow in order. A card shows its game's icon and name in the top
 * corner, its name in the middle and the icon again, upside down, in the bottom corner. On hover or keyboard focus the
 * card's face slides left so the name is whole; only the face moves, not its hit area, so it never flickers. A game
 * that is closed in this build is left out. Below 70rem (token --breakpoint-deck) the cards become a plain row (gameframe.css).
 */
import { crosswordShown, pageBuildEnv } from '../config/crossword';
import { deckOrder, type DeckGameId } from '../config/gamedeck';
import { draftsAllowed } from '../islands/anatomylab';
import { imageLogo } from '../config/gamelogos';

interface Props {
  /** The game id this page is (GameFrame's config id), left out of the deck. */
  current: string;
}
const { current } = Astro.props;
const env = pageBuildEnv();
const drafts = draftsAllowed(env);

interface DeckGame {
  name: string;
  href: string;
  open: boolean;
  /** Icon art for Light and Evening, from config/gamelogos.ts (the one source the carousel, hub and sidebar read too). */
  art?: { day: string; evening: string };
  /** The wordmark art for Light and Evening, and its natural size, from config/gamelogos.ts. */
  wordmark?: { day: string; evening: string; width: number; height: number };
  /** What the tile shows for a game without icon art. */
  glyph?: string;
}
const games: Record<DeckGameId, DeckGame> = {
  pulse: { name: 'vialo', href: '/play/vialo', open: true, art: imageLogo('vialo').icon, wordmark: imageLogo('vialo').wordmark },
  'hello-cards': { name: 'hello cards', href: '/play/hello-cards', open: drafts, glyph: 'hi' },
  triage: { name: 'sudoku', href: '/play/sudoku', open: true, glyph: '9' },
  cueword: { name: 'crossword', href: '/play/crossword', open: crosswordShown(env), glyph: '+' },
  suture: { name: 'piccline', href: '/play/piccline', open: true, art: imageLogo('piccline').deckIcon, wordmark: imageLogo('piccline').wordmark },
  stat: { name: 'tachyyy', href: '/play/tachyyy', open: drafts, art: imageLogo('tachyyy').icon, wordmark: imageLogo('tachyyy').wordmark },
};
// Front card first; a game that is closed in this build is skipped, so a card never goes nowhere.
const cards = deckOrder(current, (id) => games[id].open).map((id, index) => ({ id, ...games[id], front: index === 0 }));
const themes = [
  { key: 'day' as const, cls: 'game-deck-day' },
  { key: 'evening' as const, cls: 'game-deck-evening' },
];
---
<nav class="game-deck" aria-label="other games">
  <ul class="game-deck-list">
    {cards.map((card) => (
      <li class="game-deck-item" data-game={card.id} data-front={card.front ? 'true' : undefined}>
        <a href={card.href} class="game-deck-card">
          <span class="sr-only">{card.name}</span>
          <span class="game-deck-top" aria-hidden="true">
            <span class="game-deck-tile">
              {card.art ? themes.map((t) => <img class={`game-deck-tile-art ${t.cls}`} src={card.art![t.key]} alt="" aria-hidden="true" width="40" height="40" loading="lazy" decoding="async" />) : <span class:list={['game-deck-glyph', card.glyph === 'hi' && 'is-italic']}>{card.glyph}</span>}
            </span>
            <span class="game-deck-top-name">
              {card.wordmark ? themes.map((t) => <img class={`game-deck-wordmark game-deck-wordmark-top ${t.cls}`} src={card.wordmark![t.key]} alt="" aria-hidden="true" width={Math.round((card.wordmark!.width / card.wordmark!.height) * 100)} height="100" loading="lazy" decoding="async" />) : card.name}
            </span>
          </span>
          <span class="game-deck-name" aria-hidden="true">
            {card.wordmark ? themes.map((t) => <img class={`game-deck-wordmark game-deck-wordmark-mid ${t.cls}`} src={card.wordmark![t.key]} alt="" aria-hidden="true" width={Math.round((card.wordmark!.width / card.wordmark!.height) * 100)} height="100" loading="lazy" decoding="async" />) : card.name}
          </span>
          {card.front && <span class="game-deck-label" aria-hidden="true">next game ›</span>}
          <span class="game-deck-bottom game-deck-tile" aria-hidden="true">
            {card.art ? themes.map((t) => <img class={`game-deck-tile-art ${t.cls}`} src={card.art![t.key]} alt="" aria-hidden="true" width="40" height="40" loading="lazy" decoding="async" />) : <span class:list={['game-deck-glyph', card.glyph === 'hi' && 'is-italic']}>{card.glyph}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
