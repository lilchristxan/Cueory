---
/**
 * The footer (Task 85, Christian's final shape, 2026-11-01): one slim bar at the end of every page, never fixed or
 * sticky. Bottom-left: a flag icon ("flag or comment"). Center: the small logo, a link home. Bottom-right: a chevron
 * that opens the links panel above the bar (the motto, footer links, social links, contact email, copyright and the
 * theme switch).
 *
 * Without JavaScript the panel is simply open and the chevron stays hidden (its space is kept). The panel comes after
 * the bar in the page, so keyboard focus goes chevron → panel, and `flex-col-reverse` draws it above the bar.
 *
 * The flag opens Task 64's flag form (FlagMount) in a panel above the bar; without JavaScript it is an email link to the
 * contact address that names the page. One flag per page (Task 115). `hideFlag` hides it during sharpening rounds and timed review.
 */
import SocialLinks from './SocialLinks.astro';
import ThemePicker from './ThemePicker.astro';
import Wordmark from './Wordmark.astro';
import { footerLinks, site } from '../config/site';
import { visibleFooterLinks } from '../config/legalfooter';
import FlagMount from '../islands/FlagMount';
import { PATIENT_INFO_WARNING } from '../islands/flag';
import { flagItemContext } from '../islands/flagconnect';
import { FOOTER_TOGGLE_LABELS, flagMailto, publicPath } from '../scripts/footer';

interface Props {
  /** Sharpening rounds and timed review: no flag while the clock runs. */
  hideFlag?: boolean;
  /** The real item a question page shows (database uuids), passed down from the layout. Sample pages pass none. */
  flagItem?: { itemId: string; itemVersionId: string };
  /** The page's accounts gate is closed (/signin, /signup): the flag form stays signed out and never loads Supabase. */
  accountsOff?: boolean;
}

const { hideFlag = false, flagItem, accountsOff = false } = Astro.props;
// Fails the build for a sample slug or half a pair: submit_flag only takes real ids.
const item = flagItemContext(flagItem);
// #747: a legal page that isn't approved yet gets no footer link (Privacy always shows).
const links = visibleFooterLinks(footerLinks);
const year = new Date().getFullYear();
const barButton =
  'inline-flex size-12 items-center justify-center rounded-pill text-ink hover:bg-surface';
---

<footer class="mt-section flex flex-col-reverse" data-site-footer>
  <!-- The bar and the link row share one positioned box. In the footer the report panel (FlagForm, opened from the
       flag) is placed against this box instead of against the flag, so it opens above the link row and never covers
       part of a link: the two long classes un-position the form's own wrapper here and keep the panel in line with
       the flag (the page gutter). The bar still comes first in the page; flex-col-reverse draws the link row above it. -->
  <div
    class="relative mx-auto flex w-full max-w-page flex-col-reverse [&_[data-testid=flag-form]]:static [&_[data-testid=flag-form]>.absolute]:left-gutter"
    data-footer-base
  >
  <div class="grid h-14 w-full grid-cols-3 items-center px-gutter">
    {
      !hideFlag && (
        <div class="col-start-1 justify-self-start" id="footer-flag" data-footer-flag>
          <FlagMount
            client:only="react"
            page={Astro.url.pathname}
            itemId={item.itemId}
            itemVersionId={item.itemVersionId}
            variant="icon"
            {...(accountsOff ? { accountsOff: true } : {})}
          >
            <div slot="fallback" class="flex items-center gap-2">
            <a
                            href={flagMailto(site.contactEmail, Astro.url.pathname)}
              class={barButton}
              aria-label="flag or comment"
            >
              <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
                <path
                  d="M5 21V4M5 4h12l-3 4.5 3 4.5H5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
              <p class="max-w-56 text-xs leading-tight text-ink" data-testid="flag-fallback-warning">{PATIENT_INFO_WARNING}</p>
            </div>
          </FlagMount>
        </div>
      )
    }

    <a
      href="/"
      class="col-start-2 inline-flex min-h-12 items-center justify-self-center px-1 text-ink"
      aria-label={`${site.wordmarkName}, home`}
    >
      <Wordmark class="w-16.5" sizes="4.125rem" />
    </a>

    <button
      type="button"
      class:list={[barButton, 'group invisible col-start-3 justify-self-end']}
      aria-label={FOOTER_TOGGLE_LABELS.open}
      aria-expanded="true"
      aria-controls="site-footer-panel"
      data-footer-toggle
    >
      <!-- Points up while the panel is closed (it opens above), down while it is open. -->
      <svg
        viewBox="0 0 24 24"
        class="size-6 transition-transform duration-(--duration-base) ease-(--ease-soft) group-aria-expanded:rotate-180 motion-reduce:transition-none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
    </button>
  </div>

  <!-- The footer's links as drawn (HomeV2-3): one centered row of small underlined links, always visible. It sits after the bar
       in the page and, with flex-col-reverse, is drawn between the extras panel and the bar. -->
  <nav aria-label="footer" class="w-full px-gutter pt-6">
    <ul class="flex flex-wrap justify-center gap-x-5 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-(--tap-min) min-w-(--tap-min) items-center justify-center text-ink-soft underline underline-offset-4 wrap-anywhere hover:text-ink"
              aria-current={link.href === publicPath(Astro.url.pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  </div>

  <div id="site-footer-panel" data-footer-panel>
    <div
      class="mx-auto flex w-full max-w-page flex-col items-center gap-6 px-gutter py-8 text-center text-sm text-ink-soft"
    >
      <div class="flex flex-col items-center gap-2">
        <p class="font-bold text-ink">{site.tagline}</p>
        <SocialLinks />
        {
          site.contactEmail && (
            <p>
              <a href={`mailto:${site.contactEmail}`} class="inline-flex min-h-(--tap-min) max-w-full items-center text-ink-soft wrap-anywhere hover:text-ink">
                {site.contactEmail}
              </a>
            </p>
          )
        }
        <p>© {year} {site.wordmarkName}. study help, not medical advice.</p>
      </div>
      <ThemePicker />
    </div>
  </div>
</footer>

<script>
  import { isFooterPanelOpen, setFooterPanel } from '../scripts/footer';

  const toggle = document.querySelector<HTMLButtonElement>('[data-footer-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-footer-panel]');

  if (toggle && panel) {
    setFooterPanel(toggle, panel, false);
    toggle.addEventListener('click', () => setFooterPanel(toggle, panel, !isFooterPanelOpen(toggle)));
    toggle.classList.remove('invisible');
  }
</script>
