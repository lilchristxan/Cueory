---
import { site } from '../config/site';
---

{
  site.showBuildingNotice && (
    <div
      class="building-strip px-gutter py-2 text-center text-sm text-ink"
      role="note"
      data-testid="building-notice"
    >
      <img
        src="/design/icon-building-notice.webp"
        alt=""
        aria-hidden="true"
        width="16"
        height="16"
        loading="lazy"
        decoding="async"
        class="building-strip-icon me-2 size-4"
      />
      <span>we're still building. more coming soon.</span>
    </div>
  )
}
