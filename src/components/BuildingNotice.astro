---
import { site } from '../config/site';

const { before, link, after } = site.buildingNotice;
---

{
  site.showBuildingNotice && (
    <div
      class="building-strip px-gutter py-2 text-center text-sm text-ink"
      role="note"
      data-testid="building-notice"
    >
      <span class="building-strip-icon" aria-hidden="true"></span>
      <span class="building-strip-text">
        {before}
        {site.tipPageUrl ? (
          <a
            href={site.tipPageUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="building-strip-link"
            data-testid="building-notice-support"
          >
            {link}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          link
        )}
        {after}
      </span>
      <span class="building-strip-icon" aria-hidden="true"></span>
    </div>
  )
}
