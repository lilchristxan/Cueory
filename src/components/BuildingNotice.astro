---
import { site } from '../config/site';
---

{
  site.showBuildingNotice && (
    <div
      class="building-strip border-b border-line px-gutter py-2 text-center text-sm text-ink"
      role="note"
      data-testid="building-notice"
    >
      <svg aria-hidden="true" class="building-strip-icon me-2 size-4" viewBox="0 0 16 16" focusable="false">
        <path d="M8 0 9.5 6.5 16 8 9.5 9.5 8 16 6.5 9.5 0 8l6.5-1.5L8 0Z" fill="currentColor" />
      </svg>
      <span>we're still building. more coming soon.</span>
    </div>
  )
}
