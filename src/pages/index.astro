---
import Layout from '../layouts/Layout.astro';
import DailyGamesSection from '../components/DailyGamesSection.astro';
import VialPlatter from '../components/VialPlatter.astro';
import ComingSoon from '../components/home-v3/ComingSoon.astro';
import Social from '../components/home-v3/Social.astro';
import HomeHero from '../components/HomeHero.astro';
import ContinueBar from '../islands/ContinueBar';
import { site } from '../config/site';
---

<Layout title={site.name} variant="home">
  <!--
    The continue strip (Task 104) renders nothing for a first-time visitor. On home the corner buttons float over the
    top of the page (Layout.astro), so when the strip does show, this slot first leaves room for them; otherwise the
    floating header would sit on the strip and swallow its taps.
  -->
  <div class="continue-slot">
    <ContinueBar client:only="react" />
  </div>

  <HomeHero />

  <!--
    Home v3 (approved boards, docs/design/home-v3/README.md): hero with the stage and the explore dock (inside HomeHero),
    nurse's station games, the vial platter ("one lesson, multiple ways to study"), coming soon (the Kit email form),
    the social marks, then the footer (in the layout). The explore dock's "study materials" tile jumps to
    #ways-to-study (the platter's id), and "launch updates" links land on #signup (the coming-soon panel's id).
  -->
  <DailyGamesSection />

  <VialPlatter />

  <ComingSoon />

  <Social />
</Layout>

<script>
  import { revealSections } from '../scripts/reveal';

  revealSections();
</script>

<style>
  /* The corner row's height: two 1rem paddings (py-4) around the 44 px buttons. */
  .continue-slot:has(aside) {
    padding-top: calc(var(--tap-min) + var(--spacing) * 8);
  }
</style>
