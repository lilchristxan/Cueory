---
/** A lesson's cards (Task 300: built for every lesson whose deck may show; src/lessons/catalog.ts). */
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import LessonComingSoon from '../../../components/LessonComingSoon.astro';
import { lessonIsHeldBack } from '../../../lessons/holdback';
import ContentLabel from '../../../components/ContentLabel.astro';
import CardDeck from '../../../islands/CardDeck';
import { pathsFor, statusNotice, type CatalogLesson } from '../../../lessons/catalog';
import { lessonCatalog } from '../../../lessons/load';
import { studyModes } from '../../../config/modes';

export async function getStaticPaths() {
  return pathsFor(await lessonCatalog(), 'cards');
}

const { lesson } = Astro.props as { lesson: CatalogLesson };
const hold = await lessonIsHeldBack(lesson.id);
const deck = lesson.cards && await getEntry('cards', lesson.cards.id);
if (!deck) throw new Error(`The card file for lesson ${lesson.id} is missing.`);
const { title, cards, status } = deck.data;
const cardsNotice = statusNotice(status, 'cards');
const page = `${lesson.href}/cards`;
// The other ways to study this lesson, for the menu beside "cards" (Christian, 2026-11-26).
const otherModes = lesson.modes
  .filter((mode) => mode.id !== 'cards')
  .map((mode) => ({ href: mode.href, name: studyModes.find((known) => known.id === mode.id)?.name ?? mode.id }));
---

{hold ? <LessonComingSoon /> : (
<Layout title={title} description={`cards for ${lesson.about}.`} variant="study" bareHeader>
  {/* A focused screen, as in Christian's approved render (2026-11-26): the mode and its menu, the count and deck, close. */}
  <div class="flex items-center gap-3 px-gutter pt-4 sm:pt-5" data-testid="cards-bar">
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-1">
      <span class="min-w-0 text-lg font-bold">cards</span>
      {otherModes.length > 0 && (
        <details class="relative" data-testid="cards-switch">
          <summary aria-label="other ways to study this lesson" class="inline-flex size-(--tap-min) cursor-pointer list-none items-center justify-center rounded-pill text-ink">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <ul class="absolute start-0 top-full z-10 min-w-48 rounded-xl border border-line bg-page p-2 shadow-card">
            {otherModes.map((mode) => (
              <li><a href={mode.href} class="flex min-h-(--tap-min) items-center rounded-lg px-3 no-underline hover:bg-surface">{mode.name}</a></li>
            ))}
          </ul>
        </details>
      )}
    </div>
    <div class="min-w-0 shrink text-center leading-tight">
      <p id="cards-bar-count" class="text-sm text-ink-soft"></p>
      <h1 class="wrap-anywhere text-base font-bold lowercase max-sm:sr-only">{title}</h1>
    </div>
    <div class="flex flex-1 justify-end">
    <a
      href={lesson.href}
      aria-label="close cards"
      data-testid="cards-close"
      class="press inline-flex size-(--tap-min) shrink-0 items-center justify-center rounded-pill border border-line text-ink no-underline"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </a>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-gutter pb-section">
    <div class="mt-4">
      {/* client:only: nothing is pre-rendered, so without JavaScript only the full list below shows. */}
      <CardDeck client:only="react" deckId={deck.id} cards={cards} page={page} />
      <noscript>
        <dl class="space-y-stack">
          {
            cards.map((c) => (
              <div>
                <dt class="text-lg">{c.front}</dt>
                <dd class="mt-1 text-ink-soft">{c.back}</dd>
              </div>
            ))
          }
        </dl>
      </noscript>
    </div>

    {/* 48 px, one step above the 44 px tap minimum: at exactly 44 px Firefox measured 43.99994 (engine run 44460645965). */}
    <p class="mt-section text-sm text-ink-soft">{lesson.context} · cards</p>
    {cardsNotice && <p class="mt-2 text-sm text-ink-soft">{cardsNotice}</p>}
    <ul class="mt-3 space-y-2 text-sm">
      <li><a class="inline-flex min-h-12 items-center" href={`${lesson.href}/learn-mode`}>learn these cards in learn mode</a></li>
      <li><a class="inline-flex min-h-12 items-center" href={lesson.href}>back to the lesson</a></li>
    </ul>
    <div class="mt-8">
      <ContentLabel />
    </div>
  </div>
</Layout>
)}
