---
/**
 * Educational disclaimer (Task 200). Plain language. It repeats the content notice from src/config/site.ts so the two
 * can never disagree. No clinical facts are written here (CLAUDE.md rule 5). Not legal advice; attorney review pending.
 */
import Layout from '../layouts/Layout.astro';
import LegalApproval from '../components/LegalApproval.astro';
import { isLegalPageApproved } from '../config/legalapproval';
import Prose from '../components/Prose.astro';
import { site } from '../config/site';
---

<Layout title="disclaimer" description="Cueory is a study aid, not medical advice." noindex={!isLegalPageApproved("disclaimer")}>
  <Prose>
    <h1>disclaimer</h1>
    <LegalApproval page="disclaimer" />

    <h2>What Cueory is</h2>
    <p>
      {site.name} is a free study website made to help nursing students learn and review. Everything on it, including
      lessons, questions, cards, puzzles, videos and the anatomy lab, is for education only.
    </p>

    <h2>What Cueory is not</h2>
    <ul>
      <li>
        It is <strong class="key-term">not medical, nursing or clinical advice</strong>, and not a diagnosis, treatment
        plan or instruction for caring for any real person.
      </li>
      <li>
        It is <strong class="key-term">not a substitute for your school</strong>: your program's curriculum, your
        faculty, your textbooks, your clinical instructors and your facility's policies come first. Where the site and
        they disagree, follow them.
      </li>
      <li>It is not a licensed health-care provider, a school, or an exam board, and it does not speak for any of them.</li>
      <li>It is not an emergency service. If someone needs care, contact a clinician or local emergency services.</li>
    </ul>

    <h2>Never use it with a real patient</h2>
    <p>
      Do not use anything on {site.name} to make a decision about a real patient, to calculate a real dose, or to carry
      out a real procedure. Nursing care depends on the individual person, the setting, current evidence and the
      judgement of licensed professionals, none of which a study website can provide.
    </p>

    <h2>Accuracy and review</h2>
    <p>
      We try to keep the content accurate and up to date, but nursing knowledge changes and mistakes happen.{' '}
      {site.contentNotice}. Where a lesson is a sample, a draft or not yet reviewed, the page says so. Check anything
      that matters against your course materials and other trusted sources, and tell us about errors with the "Flag or
      comment" button at the bottom of every page.
    </p>

    <h2>Exams, grades and licensure</h2>
    <p>
      {site.name} does not promise a grade, a passing score, graduation, a licence or a job, and never predicts your
      chance of passing an exam. Exam, school and publisher names appear on the site only to describe what a lesson is
      about. They do not mean that organisation sponsors, endorses or is affiliated with {site.name}, and {site.name} is
      not an official preparation product for any exam.
    </p>

    <h2>Your responsibility</h2>
    <p>
      How you use what you learn here is up to you. By using the site you accept that {site.name} is a study aid,
      provided as is, and that we are not responsible for decisions you make based on it. Our{' '}
      <a href="/terms">terms of use</a> set out the limits on our liability.
    </p>

    <h2>Questions</h2>
    <p>Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
  </Prose>
</Layout>
