---
import Layout from '../../layouts/Layout.astro';
import GamePage from '../../components/GamePage.astro';
import SutureToday from '../../islands/SutureToday';
import { dailyGames } from '../../config/games';
import { wordPathSamples } from '../../config/gamesamples';

const game = dailyGames.find((item) => item.id === 'suture')!;
const samples = await wordPathSamples();
---
<Layout title={game.name} description={game.line} socialImage="/share/games-scene.png" promo={false}>
<GamePage game={game}>
  <h1 slot="title" id="word-path-heading" class="display mt-4 text-center text-title wrap-anywhere sm:text-title-lg">{game.name}</h1>
  <section class="mt-6" aria-labelledby="word-path-heading">
    <SutureToday client:only="react" puzzles={samples} name={game.name} />
  </section>
</GamePage>
</Layout>
