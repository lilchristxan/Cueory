---
import Layout from '../../layouts/Layout.astro';
import GamePage from '../../components/GamePage.astro';
import PilloTitle from '../../components/PilloTitle.astro';
import PulseGame from '../../islands/PulseGame';
import { dailyGames } from '../../config/games';
import { pilloSamples } from '../../config/gamesamples';

const game = { ...dailyGames[0]!, id: 'pulse' as const, name: 'pillo' };
const samples = await pilloSamples();
---
<Layout title={game.name} description={game.line} socialImage="/share/games-scene.png">
<GamePage game={game}>
  <h1 slot="title" id="pulse-heading" class="display mt-4 text-center text-title wrap-anywhere sm:text-title-lg"><PilloTitle name={game.name} /></h1>
  <section class="mt-6" aria-labelledby="pulse-heading">
    <PulseGame client:only="react" puzzles={samples} />
    <noscript><p>{game.name} needs JavaScript.</p></noscript>
  </section>
</GamePage>
</Layout>
