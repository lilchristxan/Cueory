---
import Layout from '../../layouts/Layout.astro';
import GamePage from '../../components/GamePage.astro';
import PulseGame from '../../islands/PulseGame';
import { dailyGames } from '../../config/games';
import { pilloSamples } from '../../config/gamesamples';

const game = { ...dailyGames[0]!, id: 'pulse' as const, name: 'pillo' };
const samples = await pilloSamples();
---
<Layout title={game.name} description={game.line} socialImage="/share/games-scene.png">
<GamePage game={game}>
  <h1 slot="title" id="pulse-heading" class="display mt-4 text-center text-title wrap-anywhere sm:text-title-lg">
    {/*
      The wordmark is the page's heading, so it loads eagerly. It has no Evening copy yet, and the logo rule forbids
      recolouring it, so the same artwork shows in both palettes until Christian supplies a light version.
    */}
    <img
      src="/design/logo-pillo.webp"
      width="550"
      height="208"
      alt={game.name}
      data-testid="pillo-title"
      class="mx-auto h-auto w-full max-w-xs"
      loading="eager"
      fetchpriority="high"
      data-image-priority="title"
      decoding="async"
    />
  </h1>
  <section class="mt-6" aria-labelledby="pulse-heading">
    <PulseGame client:only="react" puzzles={samples} />
    <noscript><p>{game.name} needs JavaScript.</p></noscript>
  </section>
</GamePage>
</Layout>
