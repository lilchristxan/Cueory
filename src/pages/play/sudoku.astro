---
import Layout from '../../layouts/Layout.astro';
import GamePage from '../../components/GamePage.astro';
import SudokuGame from '../../islands/SudokuGame';
import { dailyGames } from '../../config/games';

const game = dailyGames.find((item) => item.id === 'triage')!;
---
<Layout title={game.name} description={game.line} socialImage="/share/games-scene.png">
<GamePage game={game}>
  <h1 slot="title" id="sudoku-heading" class="display mt-4 text-center text-title wrap-anywhere sm:text-title-lg">{game.name}</h1>
  {/* sudoku-section and sudoku-mount: sudoku's print rules (global.css) print only the mount. */}
  <section class="sudoku-section mt-6" aria-labelledby="sudoku-heading" data-testid="sudoku-section">
    <div class="sudoku-mount">
      <SudokuGame client:only="react" />
      <noscript><p>{game.name} needs JavaScript.</p></noscript>
    </div>
  </section>
</GamePage>
</Layout>

<style>
  /* P10 surface: keep the existing game structure and interaction contract, but bring the board into the approved
   * copper/glass visual language. Shared settings, print rules and reduced-motion rules remain owned elsewhere. */
  :global(.sudoku-section) {
    container-type: inline-size;
  }

  :global(.sudoku-game) {
    color: var(--color-ink);
  }

  :global(.sudoku-panel) {
    max-inline-size: var(--sudoku-board-max);
    inline-size: 100%;
    box-sizing: border-box;
    margin-inline: auto;
    padding: var(--spacing);
    border: var(--border-game-settings) solid var(--cueory-result-card-border);
    border-radius: var(--radius-xl);
    background: var(--cueory-result-card-bg);
    box-shadow: var(--cueory-result-card-shadow);
  }

  :global(.sudoku-levels) {
    border-color: var(--cueory-result-card-border);
    background: var(--color-page);
  }

  :global(.sudoku-levels .segmented-option[aria-pressed="true"]) {
    border-radius: var(--radius-pill);
    background: var(--cueory-copper-start);
    color: var(--cueory-copper-ink);
  }

  :global(.sudoku-levels .segmented-option[aria-pressed="false"]) {
    background: var(--color-page);
    color: var(--color-ink);
  }

  :global(.sudoku-toolbar) {
    padding-block: var(--spacing);
    inline-size: min(calc(100% + var(--sudoku-box-line)), var(--sudoku-board-width));
  }

  :global(.sudoku-icon-button) {
    border-color: var(--cueory-result-card-border);
    background: var(--color-page);
    box-shadow: var(--shadow-button);
  }

  :global(.sudoku-icon-button:hover),
  :global(.sudoku-icon-button:focus-visible) {
    border-color: var(--cueory-copper-start);
    color: var(--cueory-copper-start);
  }

  /* The board keeps Daytime's structure in both palettes: light squares with dark lines and numbers (in Evening, Sand
   * squares with Charcoal), so Evening never reads as an inverted board. The board's own tokens stand in for the page
   * ones inside it, so the shared board rules pick them up. */
  :global(.sudoku-board) {
    --color-page: var(--color-sudoku-cell);
    --color-surface: var(--color-sudoku-paused);
    --color-ink: var(--color-sudoku-ink);
    --color-ink-soft: var(--color-sudoku-ink-soft);
    border-color: var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  :global(:root[data-theme="dark"] .sudoku-panel) {
    border-color: var(--cueory-glass-border);
    background: var(--color-surface);
    box-shadow: var(--cueory-glass-shadow);
  }

  :global(:root[data-theme="dark"] .sudoku-levels) {
    border-color: var(--cueory-glass-border);
    background: color-mix(in srgb, var(--cueory-glass-bg) 82%, transparent);
  }

  :global(:root[data-theme="dark"] .sudoku-icon-button),
  :global(:root[data-theme="dark"] .sudoku-number-row button),
  :global(:root[data-theme="dark"] .sudoku-tool-button),
  :global(:root[data-theme="dark"] .sudoku-setting-button) {
    border-color: var(--cueory-glass-border);
    color: var(--color-ink);
    background: var(--color-surface);
  }

  :global(.sudoku-cell.is-related) {
    background: var(--color-sudoku-related);
  }

  :global(.sudoku-cell.is-box-related) {
    background: var(--color-sudoku-box-related);
  }

  /* The route tint rules are later than the shared board rules. Keep a matching number's strong fill and ink when it
   * is also in the selected row, column or box; selection stays above all tint and conflict keeps its dashed ring. */
  :global(.sudoku-cell.is-identical.is-related),
  :global(.sudoku-cell.is-identical.is-box-related) {
    background: var(--color-sudoku-identical);
    color: var(--color-on-sudoku-identical);
    font-weight: 700;
  }

  :global(.sudoku-cell) { border-color: var(--color-ink); }

  /* The selected square (Sudoku.png): a thin deep-copper outline on Copper Shine, with no extra inset ring. The outline
   * is a shape cue as well as a colour (3:1 or more against every square it touches), and aria-selected names it. */
  :global(.sudoku-cell.is-selected) {
    background: var(--color-sudoku-selected-fill);
    color: var(--color-ink);
    outline-color: var(--color-sudoku-selected);
    box-shadow: none;
  }

  :global(.sudoku-cell.is-selected .sudoku-mark) { color: inherit; }

  :global(.sudoku-number-row button),
  :global(.sudoku-tool-button),
  :global(.sudoku-setting-button) {
    border-color: var(--cueory-result-card-border);
    background: var(--color-page);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]) .sudoku-panel) {
      border-color: var(--cueory-glass-border);
      background: var(--color-surface);
      box-shadow: var(--cueory-glass-shadow);
    }

    :global(:root:not([data-theme="light"]) .sudoku-levels) {
      border-color: var(--cueory-glass-border);
      background: color-mix(in srgb, var(--cueory-glass-bg) 82%, transparent);
    }

    :global(:root:not([data-theme="light"]) .sudoku-icon-button),
    :global(:root:not([data-theme="light"]) .sudoku-number-row button),
    :global(:root:not([data-theme="light"]) .sudoku-tool-button),
    :global(:root:not([data-theme="light"]) .sudoku-setting-button) {
      border-color: var(--cueory-glass-border);
      background: var(--color-surface);
      color: var(--color-ink);
    }
  }

  :global(.sudoku-number-row button:hover),
  :global(.sudoku-tool-button:hover),
  :global(.sudoku-setting-button:hover) {
    border-color: var(--cueory-copper-start);
  }

  :global(.sudoku-solved) {
    border-color: var(--cueory-result-card-border);
    background: var(--cueory-result-card-bg);
    color: var(--color-ink);
    box-shadow: var(--cueory-result-card-shadow);
  }

  :global(.sudoku-solved .text-ink-soft) { color: var(--color-ink); }
</style>
