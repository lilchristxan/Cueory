---
/**
 * tachyyy: fifteen hard clinical questions, 20 seconds each, score at the end.
 * Rebrands stat (Task 640).
 */
import Layout from '../../layouts/Layout.astro';
import TachyyyTitle from '../../components/TachyyyTitle.astro';
import StatGame from '../../islands/StatGame';
import GameResultsHost from '../../islands/GameResultsHost';
import { tachyyyGame } from '../../config/games';
import { draftsAllowed } from '../../islands/anatomylab';
import { parseStatSample } from '../../islands/stat';
import sample from '../../../content/games/stat/sample.json';

const env = {
  WORKERS_CI: process.env.WORKERS_CI,
  WORKERS_CI_BRANCH: process.env.WORKERS_CI_BRANCH,
  CUEORY_ANATOMY_DRAFTS: process.env.CUEORY_ANATOMY_DRAFTS,
};
const shown = draftsAllowed(env);
let parsed;
try {
  parsed = parseStatSample(sample);
} catch (error) {
  throw new Error(`content/games/stat/sample.json: ${(error as Error).message}`);
}
const { questions, sampleKey } = shown ? parsed : { questions: [], sampleKey: {} };
---

<Layout
  title={tachyyyGame.name}
  description="fifteen fast clinical questions in 30 seconds. how sharp are you on shift today?"
  noindex={true}
  promo={false}
>
  <article class="veil mx-auto mt-6 max-w-prose p-6 sm:mt-10 sm:p-10" data-pagefind-ignore>
    {shown && <p class="text-sm text-ink-soft" data-testid="stat-sample-note">sample questions · awaiting content</p>}
    <h1 class="display mt-2 text-title sm:text-title-lg">
      <TachyyyTitle name={tachyyyGame.name} />
    </h1>
    <p class="mt-3 text-ink-soft">30 seconds · 20-second clinical questions. how sharp are you on shift today?</p>
    {
      shown ? (
        <div class="mt-8">
          <StatGame client:only="react" questions={questions} sampleKey={sampleKey} />
          <noscript>
            <p>{tachyyyGame.name} needs JavaScript for its clock. you can still <a href="/play">go back to the daily games</a>.</p>
          </noscript>
        </div>
      ) : (
        <p class="mt-8" data-testid="stat-soon">{tachyyyGame.name} is coming soon.</p>
      )
    }
    <a href="/play" class="mt-10 inline-flex min-h-(--tap-min) items-center rounded-pill border border-control px-5 py-2.5 text-ink">
      back to daily games
    </a>
  </article>
  {shown && <GameResultsHost client:only="react" />}
  {shown && <noscript><p>game results and sharing need JavaScript.</p></noscript>}
</Layout>
