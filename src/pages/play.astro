---
/**
 * Daily games (D-61, D-63, D-66, D-70, D-71): the hub for the daily games in the lowercase brand voice.
 * Redesign P8 matching Games.png and Games-390.png: blister-pack game cards in stage layout.
 * Each game is played on its own page; this page has a card per game with today's status,
 * the shared settings and stats, and one quiet line saying the puzzles are labelled samples for now.
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameStatsPanel from '../islands/GameStatsPanel';
import HomeScreenTip from '../islands/HomeScreenTip';
import PlayStatus from '../islands/PlayStatus.tsx';
import { dailyGames, gamePages, helloCardsGame, helloCardsIndexWhenApproved, statGame } from '../config/games';
import { helloCardsPage } from '../islands/hello-cards';
import { draftsAllowed } from '../islands/anatomylab';
import { crosswordShown } from '../config/crossword';
// Keeps room for the browser-only cards and stats until they render, so nothing below them jumps (performance).
import '../styles/playhub.css';

// The hello cards link only exists where the cards may show: drafts stay off the live site (see helloCardsShown).
const helloEnv = {
  WORKERS_CI: process.env.WORKERS_CI,
  WORKERS_CI_BRANCH: process.env.WORKERS_CI_BRANCH,
  CUEORY_ANATOMY_DRAFTS: process.env.CUEORY_ANATOMY_DRAFTS,
};
const helloEntries = await getCollection('hello-cards');
const showHello = helloCardsPage(helloEntries.map(({ data }) => data), helloEnv, helloCardsIndexWhenApproved).linked;

// stat (Task 640) runs on labeled samples, so its link shows only where its page does (src/pages/play/stat.astro).
const showStat = draftsAllowed(helloEnv);

const pulse = dailyGames.find((game) => game.id === 'pulse')!;
const sudokuGame = dailyGames.find((game) => game.id === 'triage')!;
const crossword = dailyGames.find((game) => game.id === 'cueword')!;
const wordPath = dailyGames.find((game) => game.id === 'suture')!;

// The crossword stays out of the cards (and the stats list) while it is closed (site.ts crosswordOpen).
const showCrossword = crosswordShown(helloEnv);
const later = dailyGames.filter((game) => !game.ready && game.id !== 'cueword');

// Each game on the board (Games.png / Games-390.png), with its name and line from src/config/games.ts, the one source.
const hubGames = [pulse, sudokuGame, crossword, wordPath].map((game) => ({
  id: game.id,
  name: game.name,
  line: game.line,
  href: gamePages[game.id],
}));
// The stats list leaves the crossword out while it is closed, like the cards' "coming soon" (site.ts crosswordOpen).
const statsGames = hubGames.filter((game) => showCrossword || game.id !== 'cueword').map((game) => game.id);
---

<Layout
  title="daily games"
  description={`${showCrossword ? 'four short puzzles' : 'three short puzzles'} every day: a word to guess, sudoku, ${showCrossword ? 'a small crossword and ' : 'and '}a word path. sample puzzles for now.`}
  socialImage="/share/games-scene.png"
>
  <div class="w-full py-4 sm:py-6">
    {/* "/ daily games · [date]": the heading, then today's date from the visitor's clock (src/scripts/playdate.ts). */}
    <div class="mb-4 flex flex-wrap items-center gap-1.5 text-sm font-medium tracking-label text-ink-soft">
      <span aria-hidden="true">/</span>
      <h1 class="text-sm font-medium tracking-label text-ink-soft">daily games</h1>
      <span data-play-date hidden><span aria-hidden="true">·</span> <time data-testid="play-date"></time></span>
    </div>

    {/* Home screen tip (L2): only after puzzles finished on 3 different days, decided on page load, never mid-game. */}
    <HomeScreenTip client:only="react" />
    <noscript><p>to add cueory to your home screen, use your browser's menu. daily games need JavaScript.</p></noscript>

    {/* The four games as cards in stage layout matching Games.png and Games-390.png */}
    <div
      class="play-hub-island play-hub-cards [--play-hub-reserve:var(--play-hub-cards-reserve)] lg:[--play-hub-reserve:var(--play-hub-cards-reserve-lg)]"
    >
      <PlayStatus client:only="react" games={hubGames} isComingSoonCrossword={!showCrossword} />
    </div>
    <noscript>
      <ul class="mt-8 flex flex-col gap-3" data-testid="play-links">
        {
          hubGames.map((game) => (
            <li>
              {game.id === 'cueword' && !showCrossword ? (
                <>
                  <span class="font-medium">{game.name}</span>
                  <span class="text-ink-soft">: {game.line} (coming soon)</span>
                </>
              ) : (
                <>
                  <a href={game.href} class="font-medium">
                    {game.name}
                  </a>
                  <span class="text-ink-soft">: {game.line}</span>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </noscript>

    {/* One quiet line for every game (Christian's brief): the puzzles are labelled samples for now. */}
    <p class="mt-8 text-center text-sm text-ink-soft" data-testid="sample-note">
      for now these are sample puzzles with everyday words.
    </p>

    {/* Private stats (D-76): off until the student turns them on, kept only in this browser. */}
    <div class="play-hub-island play-hub-stats">
      <GameStatsPanel client:only="react" games={statsGames} />
    </div>

    {
      (showHello || showStat) && (
        <section class="mt-16" aria-labelledby="more-games-heading">
          <h2 id="more-games-heading" class="text-2xl font-medium">
            more games
          </h2>
          {showHello && <p class="mt-2">
            <a href={helloCardsGame.href} class="font-medium" data-testid="hello-cards-link">
              {helloCardsGame.name}
            </a>
            <span class="text-ink-soft">: {helloCardsGame.line}</span>
          </p>}
          {showStat && <p class="mt-2">
            <a href={statGame.href} class="font-medium" data-testid="stat-link">
              {statGame.name}
            </a>
            <span class="text-ink-soft">: {statGame.line}</span>
          </p>}
        </section>
      )
    }

    {
      later.length > 0 && (
        <section class="mt-16" aria-labelledby="later-heading">
          <h2 id="later-heading" class="text-2xl font-medium">
            coming soon
          </h2>
          <ul class="mt-4 flex flex-col gap-3">
            {later.map((game) => (
              <li>
                <span class="font-medium">{game.name}</span>
                <span class="text-ink-soft">: {game.line}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>

<script>
  import { followOldGameHash } from '../scripts/playhash';
  import { showPlayDate } from '../scripts/playdate';
  followOldGameHash(window.location);
  showPlayDate(document);
  // A tab left open past midnight shows the new day when the visitor comes back, as the game cards do.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') showPlayDate(document);
  });
</script>
