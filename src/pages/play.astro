---
/**
 * Daily games (D-61, D-63, D-66, D-70, D-71): the hub for the daily games in the lowercase brand voice.
 * Redesign P8 matching Games.png and Games-390.png: blister-pack game cards in stage layout.
 * Each game is played on its own page; this page has a card per game with today's status,
 * the shared settings and stats, and one quiet line saying the puzzles are labelled samples for now.
 */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GameStatsPanel from '../islands/GameStatsPanel';
import HomeScreenTip from '../islands/HomeScreenTip';
import PlayStatus from '../islands/PlayStatus.tsx';
import PlayTotals from '../islands/PlayTotals';
import { dailyGames, helloCardsGame, helloCardsIndexWhenApproved } from '../config/games';
import { hubHeadline } from '../islands/playhub';
import { gamePages } from '../config/game-pages';
import { tachyyyGame } from '../config/tachyyy';
import { helloCardsPage } from '../islands/hello-cards';
import { draftsAllowed } from '../islands/anatomylab';
import { crosswordShown } from '../config/crossword';
// Keeps room for the browser-only cards and stats until they render, so nothing below them jumps (performance).
import '../styles/playhub.css';

// The hello cards link only exists where the cards may show: drafts stay off the live site (see helloCardsShown).
const helloEnv = {
  WORKERS_CI: process.env.WORKERS_CI,
  WORKERS_CI_BRANCH: process.env.WORKERS_CI_BRANCH,
  CUEORY_ANATOMY_DRAFTS: process.env.CUEORY_ANATOMY_DRAFTS,
};
const helloEntries = await getCollection('hello-cards');
const helloPage = helloCardsPage(helloEntries.map(({ data }) => data), helloEnv, helloCardsIndexWhenApproved);
const showHello = helloPage.linked;

// stat (Task 640) runs on labeled samples, so its link shows only where its page does (src/pages/play/stat.astro).
const showStat = draftsAllowed(helloEnv);

// Each game on the hub, in the order of the picked board (option B): the real name and one-line description from
// src/config/games.ts (tachyyy's from src/config/tachyyy.ts), one source. A game closed in this build says "coming soon".
const game = (id: 'vialo' | 'cueword' | 'triage' | 'suture') => dailyGames.find((entry) => entry.id === id)!;
const showCrossword = crosswordShown(helloEnv);
const hubGames = [
  { id: 'vialo' as const, testId: 'pulse', name: game('vialo').name, line: game('vialo').line, href: gamePages.vialo, open: true, art: 'vialo' as const },
  { id: 'tachyyy' as const, testId: 'tachyyy', name: tachyyyGame.name, line: tachyyyGame.line, href: tachyyyGame.href, open: showStat, art: 'tachyyy' as const, linkTestId: 'tachyyy-link' },
  { id: 'suture' as const, testId: 'suture', name: game('suture').name, line: game('suture').line, href: gamePages.suture, open: true, art: 'piccline' as const },
  { id: 'cueword' as const, testId: 'cueword', name: game('cueword').name, line: game('cueword').line, href: gamePages.cueword, open: showCrossword },
  { id: 'triage' as const, testId: 'triage', name: game('triage').name, line: game('triage').line, href: gamePages.triage, open: true },
  { id: 'hello-cards' as const, testId: 'hello-cards', name: helloCardsGame.name, line: helloCardsGame.line, href: helloCardsGame.href, open: showHello, cards: showHello ? helloPage.starters.length : undefined, linkTestId: 'hello-cards-link' },
];
// The stats list leaves the crossword out while it is closed, like the rows' "coming soon" (site.ts crosswordOpen).
const statsGames = (['vialo', 'cueword', 'triage', 'suture'] as const).filter((id) => showCrossword || id !== 'cueword');
const statsLinks = Object.fromEntries(statsGames.map((id) => [id, gamePages[id]]));
---

<Layout
  title="daily games"
  description={`${showCrossword ? 'four short puzzles' : 'three short puzzles'} every day: a word to guess, sudoku, ${showCrossword ? 'a small crossword and ' : 'and '}a word path. sample puzzles for now.`}
  socialImage="/share/games-scene.png"
  wide
>
  <div class="mx-auto w-full max-w-(--play-hub-max)">
    {/* Home screen tip (L2): only after puzzles finished on 3 different days, decided on page load, never mid-game. */}
    <div class="px-gutter lg:px-0">
      <HomeScreenTip client:only="react" />
    </div>
    <noscript><p>to add cueory to your home screen, use your browser's menu. daily games need JavaScript.</p></noscript>

    {/* Option B (Christian, 2026-11-23): the left panel above the games on phones and tablets, beside them on desktop. */}
    <div class="grid gap-6 px-gutter py-4 sm:py-6 lg:grid-cols-[var(--play-hub-panel-width)_1fr] lg:gap-0 lg:p-0">
      <section class="flex flex-col gap-5 rounded-xl bg-surface p-6 lg:rounded-none lg:p-12" aria-labelledby="play-hub-heading">
        {/* "daily games · [date]": today's date from the visitor's clock (src/scripts/playdate.ts). */}
        <p class="flex flex-wrap items-center gap-1.5 text-sm font-medium tracking-label text-ink-soft">
          <span>daily games</span>
          <span data-play-date hidden><span aria-hidden="true">·</span> <time data-testid="play-date"></time></span>
        </p>
        <h1 id="play-hub-heading" class="display text-wrap text-(length:--play-hub-headline-size-phone) leading-tight font-medium text-ink lg:mt-6 lg:text-(length:--play-hub-headline-size)">
          {hubHeadline(hubGames.length)}
        </h1>
        {/* One quiet line (Christian's brief): the puzzles are labelled samples for now. */}
        <p class="text-base text-ink-soft" data-testid="sample-note">
          for now these are sample puzzles with everyday words.
        </p>
        <PlayTotals client:load />
      </section>

      <div class="min-w-0 lg:bg-page lg:px-16 lg:py-14">
        <PlayStatus client:load games={hubGames} />

        {/* Private stats (D-76): kept only in this browser, with "forget" buttons. */}
        <div class="play-hub-island play-hub-stats">
          <GameStatsPanel client:only="react" games={statsGames} playLinks={statsLinks} />
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { followOldGameHash } from '../scripts/playhash';
  import { showPlayDate } from '../scripts/playdate';
  followOldGameHash(window.location);
  showPlayDate(document);
  // A tab left open past midnight shows the new day when the visitor comes back, as the game cards do.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') showPlayDate(document);
  });
</script>
