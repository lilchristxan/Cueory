---
import Layout from '../layouts/Layout.astro';
import ComingSoonPanel from '../components/ComingSoonPanel.astro';
import Onboarding from '../islands/Onboarding';
import { lessonEntryHref, onboardingShown } from '../lessons/draftgate';
const entryHref = lessonEntryHref();
// The live build holds the setup questions back while accounts are closed (src/lessons/draftgate.ts).
const shown = onboardingShown();
---

{shown ? (
<Layout title="get started" promo={false} noindex description="Two optional setup questions, one at a time. Answers stay on your device.">
  <div class="mx-auto max-w-prose pt-8">
    <h1 class="text-2xl">get started</h1>
    <p class="mt-3 text-ink-soft">
      two optional questions, one at a time. you can go back, skip a question, or skip setup.
      your answers stay in this browser. when you’re signed in, your exam date is also saved to your account.
    </p>

    <div class="mt-10">
      {/* client:only: the answers are read from and saved to this browser, so there is nothing to pre-render. */}
      <Onboarding client:only="react" />
      <noscript>
        <p>these questions need javascript turned on. you can still <a href={entryHref}>start studying</a> without them.</p>
      </noscript>
    </div>
  </div>
</Layout>
) : (
<Layout
  title="coming soon: get started"
  description="the setup questions are not open yet and are coming soon to cueory. the daily games are open in the meantime."
  variant="study"
  noindex
  promo={false}
>
  <ComingSoonPanel message="the setup questions are coming soon." messageTestId="start-soon" />
</Layout>
)}
